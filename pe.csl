// pe.csl
param memcpy_params: comptime_struct;
param dM: i16; param dN: i16; param dN_y: i16; param dH: i16;
param kernel_x_dim: i16; param kernel_y_dim: i16;
param broadcast_color: color;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const timestamp = @import_module("<time>");

var time_buf_u16 = @zeros([timestamp.tsc_size_words * 2]u16);
var ptr_time_buf_u16: [*]u16 = &time_buf_u16;

var A: [dM * dH]f32;
var B: [dH * dN_y]f32;
var C: [dM * dN]f32;
var red_in: [dM]f32 = @zeros([dM]f32);
const zeros_buf = @zeros([dM]f32);

var ptr_A: [*]f32 = &A;
var ptr_B: [*]f32 = &B;
var ptr_C: [*]f32 = &C;

const send_task_id: local_task_id = @get_local_task_id(11);
const compute_task_id: local_task_id = @get_local_task_id(13);

var send_col: i16 = 0;
var recv_col: i16 = 0;

task send_b_task() void {
    if (send_col >= dN_y) return;
    const out_dsd = @get_dsd(fabout_dsd, .{ .fabric_color = broadcast_color, .extent = dH, .output_queue = @get_output_queue(2) });
    const b_ptr = @increment_dsd_offset(@get_dsd(mem1d_dsd, .{ .base_address = &B, .extent = dH }), send_col * dH, f32);
    @fmovs(out_dsd, b_ptr, .{ .async = true, .activate = send_task_id });
    send_col += 1;
}

task compute_task() void {
    if (recv_col >= dN_y) {
        timestamp.get_timestamp(@ptrcast(*[3]u16, &time_buf_u16[3]));
        sys_mod.unblock_cmd_stream();
        return;
    }

    const red_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &red_in, .extent = dM });
    const fabin_bc = @get_dsd(fabin_dsd, .{ .fabric_color = broadcast_color, .extent = 1, .input_queue = @get_input_queue(2) });
    var a_ptr = @get_dsd(mem1d_dsd, .{ .base_address = &A, .extent = dM });

    // The cycle-saver: Loop dH times, and for each incoming scalar from fabric,
    // perform a vector-scalar MAC.
    for (@range(i16, dH)) |_| {
        // Correct usage: @fmacs(dest, src1, src2, scalar_from_fabric)
        @fmacs(red_dsd, red_dsd, a_ptr, fabin_bc);
        a_ptr = @increment_dsd_offset(a_ptr, dM, f32);
    }

    const c_offset = recv_col * dM;
    const c_dsd = @increment_dsd_offset(@get_dsd(mem1d_dsd, .{ .base_address = &C, .extent = dM }), c_offset, f32);
    @fadds(c_dsd, red_dsd, @get_dsd(mem1d_dsd, .{ .base_address = &zeros_buf, .extent = dM }), .{});
    @fmovs(red_dsd, @get_dsd(mem1d_dsd, .{ .base_address = &zeros_buf, .extent = dM }), .{});

    recv_col += 1;
    @activate(compute_task_id);
}

fn broadcast_pe() void {
    timestamp.enable_tsc();
    timestamp.get_timestamp(@ptrcast(*[3]u16, &time_buf_u16[0]));

    if (layout_mod.get_y_coord() == 0) {
        @activate(send_task_id);
    }
    @activate(compute_task_id);
}

comptime {
    @bind_local_task(send_b_task, send_task_id);
    @bind_local_task(compute_task, compute_task_id);

    @export_symbol(ptr_A, "A");
    @export_symbol(ptr_B, "B");
    @export_symbol(ptr_C, "C");
    @export_symbol(ptr_time_buf_u16, "time_buf_u16");
    @export_symbol(broadcast_pe);
}