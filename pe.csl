param memcpy_params: comptime_struct;
param dM: i16;
param dN: i16;
param dN_y: i16;
param dH: i16;
param kernel_x_dim: i16;
param kernel_y_dim: i16;
param broadcast_tx_color: color;
param broadcast_rx_color: color;
param reduce_tx_color: color;
param reduce_rx_color: color;
param scatter_color: color;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const tile_config = @import_module("<tile_config>");
const timestamp = @import_module("<time>");

// TSC timer buffers
var tscStartBuffer = @zeros([timestamp.tsc_size_words]u16);
var tscEndBuffer = @zeros([timestamp.tsc_size_words]u16);
// Extended: [0..5] = start/end TSC, [6..13] = profile data (4 x u16 pairs)
var time_buf_u16 = @zeros([14]u16);
var ptr_time_buf_u16: [*]u16 = &time_buf_u16;

fn start_timer() void {
    timestamp.enable_tsc();
    timestamp.get_timestamp(&tscStartBuffer);
    time_buf_u16[0] = tscStartBuffer[0];
    time_buf_u16[1] = tscStartBuffer[1];
    time_buf_u16[2] = tscStartBuffer[2];
}

fn end_timer() void {
    timestamp.get_timestamp(&tscEndBuffer);
    time_buf_u16[3] = tscEndBuffer[0];
    time_buf_u16[4] = tscEndBuffer[1];
    time_buf_u16[5] = tscEndBuffer[2];
}

// =============================================================================
// Queue declarations
// =============================================================================
const broadcast_oq: output_queue = @get_output_queue(2);
const broadcast_iq: input_queue = @get_input_queue(3);
const relay_iq: input_queue = @get_input_queue(5);

const reduce_oq: output_queue = @get_output_queue(3);
const reduce_iq: input_queue = @get_input_queue(2);

const flyover_color: color = scatter_color;
const flyover_oq: output_queue = @get_output_queue(4);
const flyover_iq: input_queue = @get_input_queue(4);

// =============================================================================
// Storage
// =============================================================================
var A: [dM * dH]f32 = @zeros([dM * dH]f32);
var B: [dH * dN_y]f32 = @zeros([dH * dN_y]f32);
var C: [dM * dN]f32 = @zeros([dM * dN]f32);

var ptr_A: [*]f32 = &A;
var ptr_B: [*]f32 = &B;
var ptr_C: [*]f32 = &C;

var red_in: [dM]f32 = @zeros([dM]f32);

// Profiling: accumulate cycle counts per phase.
// We use the lower 16 bits of TSC for per-phase deltas (each phase < 65536 cy).
// Totals can exceed 65536, so we use two u16 words per counter (lo + hi).
// time_buf_u16[6..7] = GEMV, [8..9] = reduce, [10..11] = copy, [12..13] = overhead
var prof_gemv_lo: u16 = 0;
var prof_gemv_hi: u16 = 0;
var prof_reduce_lo: u16 = 0;
var prof_reduce_hi: u16 = 0;
var prof_copy_lo: u16 = 0;
var prof_copy_hi: u16 = 0;
var prof_overhead_lo: u16 = 0;
var prof_overhead_hi: u16 = 0;
var prof_tmp: [timestamp.tsc_size_words]u16 = @zeros([timestamp.tsc_size_words]u16);

fn read_tsc_lo() u16 {
    timestamp.get_timestamp(&prof_tmp);
    return prof_tmp[0];
}

fn prof_add(lo_ptr: *u16, hi_ptr: *u16, delta: u16) void {
    const old = lo_ptr.*;
    lo_ptr.* = old + delta;
    // If lo wrapped around, increment hi
    if (lo_ptr.* < old) {
        hi_ptr.* = hi_ptr.* + 1;
    }
}

fn store_profile() void {
    time_buf_u16[6] = prof_gemv_lo;
    time_buf_u16[7] = prof_gemv_hi;
    time_buf_u16[8] = prof_reduce_lo;
    time_buf_u16[9] = prof_reduce_hi;
    time_buf_u16[10] = prof_copy_lo;
    time_buf_u16[11] = prof_copy_hi;
    time_buf_u16[12] = prof_overhead_lo;
    time_buf_u16[13] = prof_overhead_hi;
}

// Batch receive buffer — holds dN_y columns (one sending PE's worth)
var batch_B: [dN_y * dH]f32 = @zeros([dN_y * dH]f32);
const batch_B_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &batch_B, .extent = dN_y * dH });

// Work buffer — GEMV reads from here (fixed base, comptime offsets)
var work_B: [dH]f32 = @zeros([dH]f32);
const work_B_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &work_B, .extent = dH });

// =============================================================================
// DSDs
// =============================================================================
const red_in_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &red_in, .extent = dM });
const C_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &C, .extent = dM });

const zeros_buf = @zeros([dM]f32);
const zeros_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &zeros_buf, .extent = dM });

// DSD for batch streaming receive from broadcast fabric
const fabin_batch = @get_dsd(fabin_dsd, .{
    .fabric_color = broadcast_rx_color,
    .extent = dN_y * dH,
    .input_queue = broadcast_iq,
});

// =============================================================================
// State variables
// =============================================================================
var reduce_col: i16 = 0;
var fsum_count: i16 = 0;
var col_count: i16 = 0;
var has_sent: bool = false;
var send_col: i16 = 0;
var batch_count: i16 = 0;

// Pre-computed values (set in broadcast_pe)
var my_x_val: i16 = 0;
var my_y_val: u16 = 0;
var my_send_start_col: i16 = 0;

// Total columns to process
const total_columns: i16 = @as(i16, kernel_y_dim) * dN_y;

// Task IDs
const send_task_id: local_task_id = @get_local_task_id(11);
const send_done_task_id: local_task_id = @get_local_task_id(12);
const batch_done_id: local_task_id = @get_local_task_id(13);

// =============================================================================
// Batch Done Task — process all dN_y columns, then arm next batch receive
// =============================================================================
task batch_done_task() void {
    const t_batch = read_tsc_lo();
    batch_count += 1;

    // Process all dN_y columns in this batch
    var col: i16 = 0;
    while (col < dN_y) {
        // --- Copy column from batch_B to work_B ---
        const t0 = read_tsc_lo();

        var src = @get_dsd(mem1d_dsd, .{ .base_address = &batch_B, .extent = dH });
        src = @increment_dsd_offset(src, col * dH, f32);
        @fmovs(work_B_dsd, src, .{});

        const t1 = read_tsc_lo();
        prof_add(&prof_copy_lo, &prof_copy_hi, t1 - t0);

        col_count += 1;

        // Trigger own B send at the right time
        if (!has_sent) {
            if (col_count >= my_send_start_col) {
                @activate(send_task_id);
            }
        }

        // --- GEMV: red_in += A * work_B ---
        const t2 = read_tsc_lo();

        var h: i16 = 0;
        while (h < dH) {
            const a_col = @increment_dsd_offset(
                @get_dsd(mem1d_dsd, .{ .base_address = &A, .extent = dM }),
                h * dM, f32
            );
            @fmacs(red_in_dsd, red_in_dsd, a_col, work_B[h]);
            h += 1;
        }

        const t3 = read_tsc_lo();
        prof_add(&prof_gemv_lo, &prof_gemv_hi, t3 - t2);

        // --- Synchronous reduce ---
        const t4 = read_tsc_lo();

        reduce();

        const t5 = read_tsc_lo();
        prof_add(&prof_reduce_lo, &prof_reduce_hi, t5 - t4);

        col += 1;
    }

    // Arm next batch receive if more batches expected
    if (batch_count < kernel_y_dim) {
        const t6 = read_tsc_lo();
        prof_add(&prof_overhead_lo, &prof_overhead_hi, t6 - t_batch);
        @fmovs(batch_B_dsd, fabin_batch, .{ .async = true, .activate = batch_done_id });
    }
}

// =============================================================================
// DSD Streaming Relay — hardware-speed bulk relay at y=0
// =============================================================================
fn setup_relay() void {
    const total_upstream = @as(u16, (@as(i16, kernel_y_dim) - 1) * dH * dN_y);
    const fabin_tx = @get_dsd(fabin_dsd, .{
        .fabric_color = broadcast_tx_color,
        .extent = total_upstream,
        .input_queue = relay_iq,
    });
    const fabout_rx = @get_dsd(fabout_dsd, .{
        .fabric_color = broadcast_rx_color,
        .extent = total_upstream,
        .output_queue = broadcast_oq,
    });
    @fmovs(fabout_rx, fabin_tx, .{ .async = true });
}

// =============================================================================
// Send B Data
// =============================================================================
task send_b_task() void {
    has_sent = true;
    send_col = 0;
    send_next_column();
}

fn send_next_column() void {
    if (send_col >= dN_y) { return; }
    const offset = send_col * dH;
    var b_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &B, .extent = dH });
    b_dsd = @increment_dsd_offset(b_dsd, offset, f32);
    if (my_y_val == 0) {
        const out_dsd = @get_dsd(fabout_dsd, .{
            .fabric_color = broadcast_rx_color,
            .extent = dH,
            .output_queue = broadcast_oq,
        });
        @fmovs(out_dsd, b_dsd, .{ .async = true, .activate = send_done_task_id });
    } else {
        const out_dsd = @get_dsd(fabout_dsd, .{
            .fabric_color = broadcast_tx_color,
            .extent = dH,
            .output_queue = broadcast_oq,
        });
        @fmovs(out_dsd, b_dsd, .{ .async = true, .activate = send_done_task_id });
    }
}

task send_done_task() void {
    send_col += 1;
    if (send_col < dN_y) {
        send_next_column();
    } else if (my_y_val == 0) {
        setup_relay();
    }
}

// =============================================================================
// Rotating Ring Reduction (Synchronous)
// =============================================================================
fn reduce() void {
    const my_x = my_x_val;

    const fsum_pe = reduce_col / dN;
    const isum_pe = (fsum_pe + 1) % kernel_x_dim;

    var c_col_dsd = C_dsd;
    c_col_dsd = @increment_dsd_offset(c_col_dsd, fsum_count * dM, f32);

    const fabin_reduce = @get_dsd(fabin_dsd, .{
        .fabric_color = reduce_rx_color, .extent = dM, .input_queue = reduce_iq
    });
    const fabin_flyover = @get_dsd(fabin_dsd, .{
        .fabric_color = flyover_color, .extent = dM, .input_queue = flyover_iq
    });
    const fabout_reduce = @get_dsd(fabout_dsd, .{
        .fabric_color = reduce_tx_color, .extent = dM, .output_queue = reduce_oq
    });
    const fabout_flyover = @get_dsd(fabout_dsd, .{
        .fabric_color = flyover_color, .extent = dM, .output_queue = flyover_oq
    });

    if (kernel_x_dim == 1) {
        @fmovs(c_col_dsd, red_in_dsd, .{});
        fsum_count += 1;
    } else if (my_x == isum_pe) {
        if (my_x == kernel_x_dim - 1) {
            @fmovs(fabout_flyover, red_in_dsd, .{});
        } else {
            @fmovs(fabout_reduce, red_in_dsd, .{});
        }
    } else if (my_x == fsum_pe) {
        if (my_x == 0) {
            @fadds(c_col_dsd, red_in_dsd, fabin_flyover, .{});
        } else {
            @fadds(c_col_dsd, red_in_dsd, fabin_reduce, .{});
        }
        fsum_count += 1;
    } else {
        if (my_x == 0) {
            @fadds(fabout_reduce, red_in_dsd, fabin_flyover, .{});
        } else if (my_x == kernel_x_dim - 1) {
            @fadds(fabout_flyover, red_in_dsd, fabin_reduce, .{});
        } else {
            @fadds(fabout_reduce, red_in_dsd, fabin_reduce, .{});
        }
    }

    @fmovs(red_in_dsd, zeros_dsd, .{});

    reduce_col += 1;
    if (reduce_col == total_columns) {
        terminate_kernel();
    }
}

// =============================================================================
// Entry point
// =============================================================================
fn broadcast_pe() void {
    start_timer();

    my_y_val = layout_mod.get_y_coord();
    my_x_val = @as(i16, layout_mod.get_x_coord());
    my_send_start_col = @as(i16, my_y_val) * dN_y;

    // Arm batch 0 receive (dN_y * dH wavelets from first sending PE)
    @fmovs(batch_B_dsd, fabin_batch, .{ .async = true, .activate = batch_done_id });

    if (my_y_val == 0) {
        @activate(send_task_id);
    }
}

fn terminate_kernel() void {
    store_profile();
    end_timer();
    sys_mod.unblock_cmd_stream();
}

comptime {
    @comptime_assert(@is_arch("wse2"));

    @bind_local_task(send_b_task, send_task_id);
    @bind_local_task(send_done_task, send_done_task_id);
    @bind_local_task(batch_done_task, batch_done_id);

    @export_symbol(ptr_A, "A");
    @export_symbol(ptr_B, "B");
    @export_symbol(ptr_C, "C");
    @export_symbol(ptr_time_buf_u16, "time_buf_u16");
    @export_symbol(broadcast_pe);
}
