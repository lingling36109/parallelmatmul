param bcast_up_color: color;
param sentinel_color: color;
param bcast_down_colors: [8]color;
param pe_y: i16;
// ... (include all other params from your original pe.csl)

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);

var b_buf = @zeros([dN * dH]f32);
var current_row_processing: i16 = 0;

// DSD for my local B data broadcast
const my_bcast_dsd = @get_dsd(fabbric_dsd, .{
    .extent = dN * dH,
    .fabric_color = (pe_y == 0) ? bcast_down_colors[0] : bcast_up_color,
    .output_queue = @get_output_queue(1)
});

// TASK: PE 0 Repeater (Only active on Row 0)
// Forwards data from UP color to the specific DOWN color for the current sender
task repeater_task(data: f32) void {
    const down_color = bcast_down_colors[current_row_processing];
    const out_dsd = @get_dsd(fabbric_dsd, .{
        .extent = dN * dH,
        .fabric_color = down_color,
        .output_queue = @get_output_queue(2)
    });
    // This blocks until the whole stream is moved
    @fmovs(out_dsd, @get_dsd(fabbric_dsd, .{ .extent = dN * dH, .fabric_color = bcast_up_color }));
}

// TASK: Start my broadcast (When it's my turn)
task send_my_b_task() void {
    @fmovs(my_bcast_dsd, @get_dsd(mem1d_dsd, .{ .tensor_access = |i| b_buf[i], .extent = dN * dH }));

    // Pass the turn to the PE below me
    if (pe_y < kernel_y_dim - 1) {
        const sen_dsd = @get_dsd(fabbric_dsd, .{ .extent = 1, .fabric_color = sentinel_color });
        @mov32(sen_dsd, 1.0f32);
    }
}

// Handle data from any row broadcast
fn process_incoming_b(sender_id: i16) void {
    // 1. Multiply with local A
    // 2. Call reduce()
    // 3. current_row_processing++
    // 4. If current == kernel_y_dim, terminate_kernel()
}

// Entry point
fn broadcast_pe() void {
    if (pe_y == 0) {
        @activate(send_my_b_task);
    }
}

comptime {
    if (pe_y == 0) {
        @bind_data_task(repeater_task, @get_data_task_id(bcast_up_color));
    }

    // Bind the sentinel task to start my send
    @bind_data_task(send_my_b_task, @get_data_task_id(sentinel_color));

    // Bind each broadcast color to a handler that maintains order
    // (Ensure these handlers call process_incoming_b with the right index)
    @bind_data_task(recv_0, @get_data_task_id(bcast_down_colors[0]));
    @bind_data_task(recv_1, @get_data_task_id(bcast_down_colors[1]));
    // ... repeat for 0-7 ...
}