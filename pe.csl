param memcpy_params: comptime_struct;
param dM: i16;
param dN: i16;
param dN_y: i16;
param dH: i16;
param kernel_x_dim: i16;
param kernel_y_dim: i16;
param broadcast_tx_color: color;
param broadcast_rx_color: color;
param reduce_tx_color: color;
param reduce_rx_color: color;
param scatter_color: color;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const tile_config = @import_module("<tile_config>");
const timestamp = @import_module("<time>");

// TSC timer buffers
var tscStartBuffer = @zeros([timestamp.tsc_size_words]u16);
var tscEndBuffer = @zeros([timestamp.tsc_size_words]u16);
var time_buf_u16 = @zeros([timestamp.tsc_size_words * 2]u16);
var ptr_time_buf_u16: [*]u16 = &time_buf_u16;

fn start_timer() void {
    timestamp.enable_tsc();
    timestamp.get_timestamp(&tscStartBuffer);
}

fn end_timer() void {
    timestamp.get_timestamp(&tscEndBuffer);
    time_buf_u16[0] = tscStartBuffer[0];
    time_buf_u16[1] = tscStartBuffer[1];
    time_buf_u16[2] = tscStartBuffer[2];
    time_buf_u16[3] = tscEndBuffer[0];
    time_buf_u16[4] = tscEndBuffer[1];
    time_buf_u16[5] = tscEndBuffer[2];
}

// Queues
const broadcast_oq: output_queue = @get_output_queue(2);
const broadcast_iq: input_queue = @get_input_queue(3);
const relay_iq: input_queue = @get_input_queue(5);
const reduce_oq: output_queue = @get_output_queue(3);
const reduce_iq: input_queue = @get_input_queue(2);
const flyover_oq: output_queue = @get_output_queue(4);
const flyover_iq: input_queue = @get_input_queue(4);

// Storage
var A: [dM * dH]f32 = @zeros([dM * dH]f32);
var B: [dH * dN_y]f32 = @zeros([dH * dN_y]f32);
var C: [dM * dN]f32 = @zeros([dM * dN]f32);
var red_in: [dM]f32 = @zeros([dM]f32);
var buf_B: [dH]f32 = @zeros([dH]f32);

// DSDs
const buf_B_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &buf_B, .extent = dH });
const red_in_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &red_in, .extent = dM });
const zeros_dsd  = @get_dsd(mem1d_dsd, .{ .base_address = @zeros([dM]f32), .extent = dM });

const fabin_broadcast = @get_dsd(fabin_dsd, .{
    .fabric_color = broadcast_rx_color, .extent = dH, .input_queue = broadcast_iq,
});

// State
var reduce_col: i16 = 0;
var col_count: i16 = 0;
var my_x_val: i16 = 0;
var my_y_val: u16 = 0;
var my_send_start_col: i16 = 0;
const total_columns: i16 = @as(i16, kernel_y_dim) * dN_y;

// Task IDs
const send_task_id: local_task_id = @get_local_task_id(11);
const send_done_task_id: local_task_id = @get_local_task_id(12);
const column_done_id: local_task_id = @get_local_task_id(13);
const reduce_done_task_id: local_task_id = @get_local_task_id(14);

fn receive_next_column() void {
    @fmovs(buf_B_dsd, fabin_broadcast, .{ .async = true, .activate = column_done_id });
}

task column_done_task() void {
    col_count += 1;
    if (col_count == my_send_start_col + 1 && my_y_val != 0) {
        @activate(send_task_id);
    }

    // Batched GEMV
    for (@range(i16, dH)) |h| {
        const a_col = @increment_dsd_offset(@get_dsd(mem1d_dsd, .{ .base_address = &A, .extent = dM }), h * dM, f32);
        @fmacs(red_in_dsd, red_in_dsd, a_col, buf_B[h]);
    }

    if (col_count < total_columns) { receive_next_column(); }
    reduce();
}

task reduce_done_task() void {
    // Reset local partial sum ONLY after reduction is safely in fabric/memory
    @fmovs(red_in_dsd, zeros_dsd, .{});
    reduce_col += 1;
    if (reduce_col == total_columns) { terminate_kernel(); }
}

fn reduce() void {
    const fabin_red = @get_dsd(fabin_dsd, .{ .fabric_color = reduce_rx_color, .extent = dM, .input_queue = reduce_iq });
    const fabin_fly = @get_dsd(fabin_dsd, .{ .fabric_color = scatter_color, .extent = dM, .input_queue = flyover_iq });
    const fabout_red = @get_dsd(fabout_dsd, .{ .fabric_color = reduce_tx_color, .extent = dM, .output_queue = reduce_oq });
    const fabout_fly = @get_dsd(fabout_dsd, .{ .fabric_color = scatter_color, .extent = dM, .output_queue = flyover_oq });

    var c_col_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &C, .extent = dM });
    c_col_dsd = @increment_dsd_offset(c_col_dsd, reduce_col * dM, f32);

    if (kernel_x_dim == 1) {
        @fmovs(c_col_dsd, red_in_dsd, .{ .async = true, .activate = reduce_done_task_id });
    } else if (my_x_val == 0) {
        @fmovs(fabout_red, red_in_dsd, .{ .async = true });
        @fmovs(c_col_dsd, fabin_fly, .{ .async = true, .activate = reduce_done_task_id });
    } else if (my_x_val == kernel_x_dim - 1) {
        // Final PE accumulates and starts the scatter back West
        @fadds(fabout_fly, red_in_dsd, fabin_red, .{ .async = true });
        @fadds(c_col_dsd, red_in_dsd, fabin_red, .{ .async = true, .activate = reduce_done_task_id });
    } else {
        // Middle PEs: Forward reduction East, then forward scatter West
        @fadds(fabout_red, red_in_dsd, fabin_red, .{ .async = true });
        @fmovs(fabout_fly, fabin_fly, .{ .async = true });
        @fmovs(c_col_dsd, fabin_fly, .{ .async = true, .activate = reduce_done_task_id });
    }
}

fn setup_relay() void {
    const total_upstream = @as(u16, (@as(i16, kernel_y_dim) - 1) * dH * dN_y);
    const f_in = @get_dsd(fabin_dsd, .{ .fabric_color = broadcast_tx_color, .extent = total_upstream, .input_queue = relay_iq });
    const f_out = @get_dsd(fabout_dsd, .{ .fabric_color = broadcast_rx_color, .extent = total_upstream, .output_queue = broadcast_oq });
    @fmovs(f_out, f_in, .{ .async = true });
}

task send_b_task() void {
    const out_color = if (my_y_val == 0) broadcast_rx_color else broadcast_tx_color;
    for (@range(i16, dN_y)) |n| {
        var b_col = @get_dsd(mem1d_dsd, .{ .base_address = &B, .extent = dH });
        b_col = @increment_dsd_offset(b_col, n * dH, f32);
        const f_out = @get_dsd(fabout_dsd, .{ .fabric_color = out_color, .extent = dH, .output_queue = broadcast_oq });
        @fmovs(f_out, b_col, .{}); // Synchronous send to save microthreads
    }
}

fn broadcast_pe() void {
    start_timer();
    my_y_val = layout_mod.get_y_coord();
    my_x_val = @as(i16, layout_mod.get_x_coord());
    my_send_start_col = @as(i16, my_y_val) * dN_y;

    if (my_y_val == 0) {
        setup_relay();
        @activate(send_task_id);
    }
    receive_next_column();
}

fn terminate_kernel() void {
    end_timer();
    sys_mod.unblock_cmd_stream();
}

comptime {
    @comptime_assert(@is_arch("wse2"));
    @bind_local_task(send_b_task, send_task_id);
    @bind_local_task(column_done_task, column_done_id);
    @bind_local_task(reduce_done_task, reduce_done_task_id);
    @export_symbol(&A, "A"); @export_symbol(&B, "B"); @export_symbol(&C, "C");
    @export_symbol(ptr_time_buf_u16, "time_buf_u16");
    @export_symbol(broadcast_pe);
}