// Parameters from layout
param memcpy_params: comptime_struct;
param dM: i16;
param dN: i16;
param dN_y: i16;
param dH: i16;
param kernel_x_dim: i16;
param kernel_y_dim: i16;
param my_bcast_color: color;
param reduce_0_tx_color: color;
param reduce_0_rx_color: color;
param reduce_0_flyover_color: color;
param reduce_1_tx_color: color;
param reduce_1_rx_color: color;
param reduce_1_flyover_color: color;

// Broadcast receive colors (one per PE row, up to 8)
param bcast_color_0: color;
param bcast_color_1: color;
param bcast_color_2: color;
param bcast_color_3: color;
param bcast_color_4: color;
param bcast_color_5: color;
param bcast_color_6: color;
param bcast_color_7: color;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const timestamp = @import_module("<time>");

const STREAM_WINDOW: i16 = 2;

// =============================================================================
// TSC timer buffers
// =============================================================================
var tscStartBuffer = @zeros([timestamp.tsc_size_words]u16);
var tscEndBuffer = @zeros([timestamp.tsc_size_words]u16);
var time_buf_u16 = @zeros([timestamp.tsc_size_words * 2]u16);
var ptr_time_buf_u16: [*]u16 = &time_buf_u16;

fn start_timer() void {
    timestamp.enable_tsc();
    timestamp.get_timestamp(&tscStartBuffer);
    time_buf_u16[0] = tscStartBuffer[0];
    time_buf_u16[1] = tscStartBuffer[1];
    time_buf_u16[2] = tscStartBuffer[2];
}

fn end_timer() void {
    timestamp.get_timestamp(&tscEndBuffer);
    time_buf_u16[3] = tscEndBuffer[0];
    time_buf_u16[4] = tscEndBuffer[1];
    time_buf_u16[5] = tscEndBuffer[2];
}

// =============================================================================
// Queue declarations
// =============================================================================
const broadcast_oq: output_queue = @get_output_queue(2);

const reduce_0_oq: output_queue = @get_output_queue(3);
const reduce_0_iq: input_queue = @get_input_queue(2);
const flyover_0_oq: output_queue = @get_output_queue(4);
const flyover_0_iq: input_queue = @get_input_queue(4);

const reduce_1_oq: output_queue = @get_output_queue(5);
const reduce_1_iq: input_queue = @get_input_queue(3);
const flyover_1_oq: output_queue = @get_output_queue(6);
const flyover_1_iq: input_queue = @get_input_queue(5);

// =============================================================================
// Storage
// =============================================================================
var A: [dM * dH]f32 = @zeros([dM * dH]f32);
var B: [dH * dN_y]f32 = @zeros([dH * dN_y]f32);
var C: [dM * dN]f32 = @zeros([dM * dN]f32);

var ptr_A: [*]f32 = &A;
var ptr_B: [*]f32 = &B;
var ptr_C: [*]f32 = &C;

var accums: [2 * dM]f32 = @zeros([2 * dM]f32);
var lane_wcount: [2]i16 = @zeros([2]i16);
var lane_colcount: [2]i16 = @zeros([2]i16);
var lane_stream: [2]i16 = @zeros([2]i16);
var source_done: [8]u16 = @zeros([8]u16);

const zeros_buf = @zeros([dM]f32);
const zeros_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &zeros_buf, .extent = dM });

// =============================================================================
// Global state
// =============================================================================
var reduce_count: i16 = 0;
var has_sent: bool = false;
var send_col: i16 = 0;

// Task IDs
const send_task_id: local_task_id = @get_local_task_id(16);
const send_done_task_id: local_task_id = @get_local_task_id(17);

fn maybe_activate_sender(completed_stream: i16) void {
    const my_y = @as(i16, layout_mod.get_y_coord());
    const next_stream = completed_stream + STREAM_WINDOW;

    if (next_stream >= kernel_y_dim) { return; }
    if (my_y != next_stream) { return; }
    if (has_sent) { return; }

    @activate(send_task_id);
}

fn reduce(lane: i16, global_col: i16) void {
    const my_x = @as(i16, layout_mod.get_x_coord());
    const fsum_pe = global_col / dN;
    const isum_pe = (fsum_pe + 1) % kernel_x_dim;
    const local_c_col = global_col - fsum_pe * dN;

    var c_col_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &C, .extent = dM });
    c_col_dsd = @increment_dsd_offset(c_col_dsd, local_c_col * dM, f32);

    var accum_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &accums, .extent = dM });
    accum_dsd = @increment_dsd_offset(accum_dsd, lane * dM, f32);

    if (lane == 0) {
        const fabin_reduce = @get_dsd(fabin_dsd, .{
            .fabric_color = reduce_0_rx_color,
            .extent = dM,
            .input_queue = reduce_0_iq,
        });
        const fabin_flyover = @get_dsd(fabin_dsd, .{
            .fabric_color = reduce_0_flyover_color,
            .extent = dM,
            .input_queue = flyover_0_iq,
        });
        const fabout_reduce = @get_dsd(fabout_dsd, .{
            .fabric_color = reduce_0_tx_color,
            .extent = dM,
            .output_queue = reduce_0_oq,
        });
        const fabout_flyover = @get_dsd(fabout_dsd, .{
            .fabric_color = reduce_0_flyover_color,
            .extent = dM,
            .output_queue = flyover_0_oq,
        });

        if (my_x == isum_pe) {
            if (my_x == kernel_x_dim - 1) {
                @fmovs(fabout_flyover, accum_dsd, .{});
            } else {
                @fmovs(fabout_reduce, accum_dsd, .{});
            }
        } else if (my_x == fsum_pe) {
            if (my_x == 0) {
                @fadds(c_col_dsd, accum_dsd, fabin_flyover, .{});
            } else {
                @fadds(c_col_dsd, accum_dsd, fabin_reduce, .{});
            }
        } else {
            if (my_x == 0) {
                @fadds(fabout_reduce, accum_dsd, fabin_flyover, .{});
            } else if (my_x == kernel_x_dim - 1) {
                @fadds(fabout_flyover, accum_dsd, fabin_reduce, .{});
            } else {
                @fadds(fabout_reduce, accum_dsd, fabin_reduce, .{});
            }
        }
    } else {
        const fabin_reduce = @get_dsd(fabin_dsd, .{
            .fabric_color = reduce_1_rx_color,
            .extent = dM,
            .input_queue = reduce_1_iq,
        });
        const fabin_flyover = @get_dsd(fabin_dsd, .{
            .fabric_color = reduce_1_flyover_color,
            .extent = dM,
            .input_queue = flyover_1_iq,
        });
        const fabout_reduce = @get_dsd(fabout_dsd, .{
            .fabric_color = reduce_1_tx_color,
            .extent = dM,
            .output_queue = reduce_1_oq,
        });
        const fabout_flyover = @get_dsd(fabout_dsd, .{
            .fabric_color = reduce_1_flyover_color,
            .extent = dM,
            .output_queue = flyover_1_oq,
        });

        if (my_x == isum_pe) {
            if (my_x == kernel_x_dim - 1) {
                @fmovs(fabout_flyover, accum_dsd, .{});
            } else {
                @fmovs(fabout_reduce, accum_dsd, .{});
            }
        } else if (my_x == fsum_pe) {
            if (my_x == 0) {
                @fadds(c_col_dsd, accum_dsd, fabin_flyover, .{});
            } else {
                @fadds(c_col_dsd, accum_dsd, fabin_reduce, .{});
            }
        } else {
            if (my_x == 0) {
                @fadds(fabout_reduce, accum_dsd, fabin_flyover, .{});
            } else if (my_x == kernel_x_dim - 1) {
                @fadds(fabout_flyover, accum_dsd, fabin_reduce, .{});
            } else {
                @fadds(fabout_reduce, accum_dsd, fabin_reduce, .{});
            }
        }
    }
}

fn handle_bcast(stream: i16, val: f32) void {
    const lane = stream % 2;

    if (lane_stream[lane] != stream) {
        lane_stream[lane] = stream;
        lane_wcount[lane] = 0;
        lane_colcount[lane] = 0;
    }

    var accum_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &accums, .extent = dM });
    accum_dsd = @increment_dsd_offset(accum_dsd, lane * dM, f32);

    var a_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &A, .extent = dM });
    a_dsd = @increment_dsd_offset(a_dsd, lane_wcount[lane] * dM, f32);

    @fmacs(accum_dsd, accum_dsd, a_dsd, val);

    lane_wcount[lane] += 1;
    if (lane_wcount[lane] != dH) { return; }

    lane_wcount[lane] = 0;

    const global_col = stream * dN_y + lane_colcount[lane];
    reduce(lane, global_col);
    @fmovs(accum_dsd, zeros_dsd, .{});

    lane_colcount[lane] += 1;
    reduce_count += 1;

    if (lane_colcount[lane] == dN_y) {
        source_done[stream] = 1;
        maybe_activate_sender(stream);
    }

    if (reduce_count == @as(i16, kernel_y_dim) * dN_y) {
        terminate_kernel();
    }
}

// =============================================================================
// Per-stream data tasks
// =============================================================================
task recv_bcast_0(val: f32) void { handle_bcast(0, val); }
task recv_bcast_1(val: f32) void { handle_bcast(1, val); }
task recv_bcast_2(val: f32) void { handle_bcast(2, val); }
task recv_bcast_3(val: f32) void { handle_bcast(3, val); }
task recv_bcast_4(val: f32) void { handle_bcast(4, val); }
task recv_bcast_5(val: f32) void { handle_bcast(5, val); }
task recv_bcast_6(val: f32) void { handle_bcast(6, val); }
task recv_bcast_7(val: f32) void { handle_bcast(7, val); }

// =============================================================================
// Send B data
// =============================================================================
task send_b_task() void {
    has_sent = true;
    send_col = 0;
    send_next_column();
}

fn send_next_column() void {
    if (send_col >= dN_y) { return; }

    var b_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &B, .extent = dH });
    b_dsd = @increment_dsd_offset(b_dsd, send_col * dH, f32);

    const out_dsd = @get_dsd(fabout_dsd, .{
        .fabric_color = my_bcast_color,
        .extent = dH,
        .output_queue = broadcast_oq,
    });
    @fmovs(out_dsd, b_dsd, .{ .async = true, .activate = send_done_task_id });
}

task send_done_task() void {
    send_col += 1;
    send_next_column();
}

// =============================================================================
// Entry point
// =============================================================================
fn broadcast_pe() void {
    start_timer();
    const my_y = @as(i16, layout_mod.get_y_coord());

    lane_stream[0] = 0;
    lane_stream[1] = 1;

    if (my_y < STREAM_WINDOW) {
        @activate(send_task_id);
    }
}

fn terminate_kernel() void {
    end_timer();
    sys_mod.unblock_cmd_stream();
}

comptime {
    @comptime_assert(@is_arch("wse2"));

    @bind_data_task(recv_bcast_0, @get_data_task_id(bcast_color_0));
    @bind_data_task(recv_bcast_1, @get_data_task_id(bcast_color_1));
    if (kernel_y_dim > 2) { @bind_data_task(recv_bcast_2, @get_data_task_id(bcast_color_2)); }
    if (kernel_y_dim > 3) { @bind_data_task(recv_bcast_3, @get_data_task_id(bcast_color_3)); }
    if (kernel_y_dim > 4) { @bind_data_task(recv_bcast_4, @get_data_task_id(bcast_color_4)); }
    if (kernel_y_dim > 5) { @bind_data_task(recv_bcast_5, @get_data_task_id(bcast_color_5)); }
    if (kernel_y_dim > 6) { @bind_data_task(recv_bcast_6, @get_data_task_id(bcast_color_6)); }
    if (kernel_y_dim > 7) { @bind_data_task(recv_bcast_7, @get_data_task_id(bcast_color_7)); }

    @bind_local_task(send_b_task, send_task_id);
    @bind_local_task(send_done_task, send_done_task_id);

    @export_symbol(ptr_A, "A");
    @export_symbol(ptr_B, "B");
    @export_symbol(ptr_C, "C");
    @export_symbol(ptr_time_buf_u16, "time_buf_u16");
    @export_symbol(broadcast_pe);
}
