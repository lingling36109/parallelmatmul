// pe.csl
param bcast_up_color: color;
param next_pe_color: color;
param bcast_down_colors: [8]color;
param pe_y: i16;
// ... (other existing params)

// Task IDs
const send_b_task_id: data_task_id = @get_data_task_id(bcast_up_color);
const token_task_id:  data_task_id = @get_data_task_id(next_pe_color);

var b_buf = @zeros([dN * dH]f32);
var current_bcast_sender: i16 = 0;

// DSDs for sending B
// If row 0, send directly to down-color. Others send to UP-color.
const b_out_dsd = @get_dsd(fabbric_dsd, .{
    .extent = dN * dH,
    .fabric_color = (pe_y == 0) ? bcast_down_colors[0] : bcast_up_color,
    .output_queue = @get_output_queue(1)
});

// Row 0 Repeater: Receives from UP, sends to the specific DOWN color
// This task only runs on PE(x, 0)
task row0_repeater(data: f32) void {
    const down_dsd = @get_dsd(fabbric_dsd, .{
        .extent = dN * dH,
        .fabric_color = bcast_down_colors[current_bcast_sender],
        .output_queue = @get_output_queue(2)
    });
    // Use asynchronous move to forward the whole stream
    @fmovs(down_dsd, @get_dsd(fabbric_dsd, .{ .extent = dN * dH, .fabric_color = bcast_up_color }));
}

// When a broadcast from sender 'i' finishes, move to sender 'i+1'
fn finish_bcast_segment() void {
    current_bcast_sender += 1;
    if (current_bcast_sender < kernel_y_dim) {
        // Trigger reduction for the finished B-segment
        reduce();
    } else {
        // All segments done
        terminate_kernel();
    }
}

// Sequencer: Start my broadcast
task start_my_send() void {
    @fmovs(b_out_dsd, @get_dsd(mem1d_dsd, .{ .tensor_access = |i| b_buf[i], .extent = dN * dH }));

    // Signal the next PE to start
    if (pe_y < kernel_y_dim - 1) {
        const next_dsd = @get_dsd(fabbric_dsd, .{ .extent = 1, .fabric_color = next_pe_color });
        @mov32(next_dsd, 1.0f32);
    }
}

// Entry Point
fn broadcast_pe() void {
    if (pe_y == 0) {
        @activate(start_my_send);
    }
}

comptime {
    // Row 0 listens for data coming UP to repeat it DOWN
    if (pe_y == 0) {
        @bind_data_task(row0_repeater, @get_data_task_id(bcast_up_color));
    }

    // Everyone listens for the token to start their send
    @bind_data_task(start_my_send, token_task_id);

    // Bind all 8 broadcast receive tasks to handle the data in order
    // Ensure handle_bcast calls finish_bcast_segment() upon completion
    @bind_data_task(handle_bcast0, @get_data_task_id(bcast_down_colors[0]));
    @bind_data_task(handle_bcast1, @get_data_task_id(bcast_down_colors[1]));
    // ... repeat for 0-7 ...
}