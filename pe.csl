param memcpy_params: comptime_struct;
param dM: i16;
param dH: i16;
param dN: i16;
param kernel_x_dim: i16;
param kernel_y_dim: i16;
param my_bcast_color: color;

param bcast_color_0: color;
param bcast_color_1: color;
param bcast_color_2: color;
param bcast_color_3: color;
param bcast_color_4: color;
param bcast_color_5: color;
param bcast_color_6: color;
param bcast_color_7: color;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const timestamp = @import_module("<time>");

// Buffers
var B = @zeros([dH * dN]f32);
var C = @zeros([dM * dN]f32);
var time_buf = @zeros([6]u16);
var ptr_time_buf: [*]u16 = &time_buf;

// Task IDs: Using ID 28 to stay clear of color-mapped task IDs (which are usually < 24)
const compute_task_id: local_task_id = @get_local_task_id(28);

// DSDs
const out_dsd = @get_dsd(fabout_dsd, .{
    .extent = dN,
    .fabric_color = my_bcast_color,
    .output_queue = @get_output_queue(1)
});

const b_mem_dsd = @get_dsd(mem1d_dsd, .{
    .tensor_access = |i|{dH * dN} -> B[i]
});

// Tasks
task do_compute() void {
    // Local compute logic for B-block broadcast
    @mov32(out_dsd, b_mem_dsd);
}

// Data tasks for receiving broadcasts
task recv_0(data: f32) void { C[0] += data; }
task recv_1(data: f32) void { C[0] += data; }
task recv_2(data: f32) void { C[0] += data; }
task recv_3(data: f32) void { C[0] += data; }
task recv_4(data: f32) void { C[0] += data; }
task recv_5(data: f32) void { C[0] += data; }
task recv_6(data: f32) void { C[0] += data; }
task recv_7(data: f32) void { C[0] += data; }

fn broadcast_pe() void {
    timestamp.get_tsc(ptr_time_buf);
    @activate(compute_task_id);
}

fn terminate_kernel() void {
    timestamp.get_tsc(ptr_time_buf + 3);
    sys_mod.unblock_cmd_stream();
}

comptime {
    @bind_local_task(do_compute, compute_task_id);

    // Bind tasks to colors 8 through 15
    @bind_data_task(recv_0, @get_data_task_id(bcast_color_0));
    @bind_data_task(recv_1, @get_data_task_id(bcast_color_1));
    @bind_data_task(recv_2, @get_data_task_id(bcast_color_2));
    @bind_data_task(recv_3, @get_data_task_id(bcast_color_3));
    @bind_data_task(recv_4, @get_data_task_id(bcast_color_4));
    @bind_data_task(recv_5, @get_data_task_id(bcast_color_5));
    @bind_data_task(recv_6, @get_data_task_id(bcast_color_6));
    @bind_data_task(recv_7, @get_data_task_id(bcast_color_7));

    @export_symbol(ptr_time_buf, "time_buf_u16");
    @export_symbol(broadcast_pe);
    @export_symbol(terminate_kernel);
}