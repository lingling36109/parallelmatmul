// Color map
//
//  ID var                   ID var  ID var               ID var
//   0 broadcast_rx_color    9       18                   27 reserved (memcpy)
//   1 broadcast_tx_color    10      19                   28 reserved (memcpy)
//   2 MEMCPYH2D_1           11      20                   29 reserved
//   3 MEMCPYH2D_2           12      21 reserved (memcpy) 30 reserved (memcpy)
//   4 MEMCPYD2H_1           13      22 reserved (memcpy) 31 reserved
//   5 reduce_A_color        14      23 reserved (memcpy) 32
//   6 reduce_B_color        15      24                   33
//   7 reduce_C_color        16      25                   34
//   8                       17      26                   35

// Parameters and imports remain the same [cite: 45-49]
param memcpy_params: comptime_struct;
param dM: i16;
param dN: i16;
param dN_y: i16;
param dH: i16;
param kernel_x_dim: i16;
param kernel_y_dim: i16;
param my_bcast_color: color;
param reduce_tx_color: color;
param reduce_rx_color: color;
param scatter_color: color;
param bcast_color_0: color;
param bcast_color_1: color;
param bcast_color_2: color;
param bcast_color_3: color;
param bcast_color_4: color;
param bcast_color_5: color;
param bcast_color_6: color;
param bcast_color_7: color;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const timestamp = @import_module("<time>");

// Timer and Queue declarations [cite: 50-54]
var time_buf_u16 = @zeros([timestamp.tsc_size_words * 2]u16);
const broadcast_oq: output_queue = @get_output_queue(2);
const reduce_oq: output_queue = @get_output_queue(3);
const reduce_iq: input_queue = @get_input_queue(2);
const flyover_color: color = scatter_color;
const flyover_oq: output_queue = @get_output_queue(4);
const flyover_iq: input_queue = @get_input_queue(4);

// Storage
var A: [dM * dH]f32 = @zeros([dM * dH]f32);
var B: [dH * dN_y]f32 = @zeros([dH * dN_y]f32);
var C: [dM * dN]f32 = @zeros([dM * dN]f32);

// Double-buffered accumulators (2 buffers per stream)
var accums: [2 * 8 * dM]f32 = @zeros([2 * 8 * dM]f32);
var active_buf_idx: [8]i16 = @zeros([8]i16); // 0 or 1 for each stream

var stream_wcount: [8]i16 = @zeros([8]i16);
var stream_colcount: [8]i16 = @zeros([8]i16);
const zeros_buf = @zeros([dM]f32);
const zeros_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &zeros_buf, .extent = dM });

var reduce_count: i16 = 0;
const send_task_id: local_task_id = @get_local_task_id(16);

// Optimized Broadcast Handler
fn handle_bcast(stream: i16, val: f32) void {
    const buf_idx = active_buf_idx[stream];
    // Offset accounts for double buffering: (ping_pong_offset + stream_offset)
    var accum_dsd = @get_dsd(mem1d_dsd, .{
        .base_address = &accums,
        .extent = dM
    });
    accum_dsd = @increment_dsd_offset(accum_dsd, (buf_idx * 8 + stream) * dM, f32);

    // Clear buffer at the start of a new column cycle
    if (stream_wcount[stream] == 0) {
        @fmovs(accum_dsd, zeros_dsd, .{});
    }

    var a_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &A, .extent = dM });
    a_dsd = @increment_dsd_offset(a_dsd, stream_wcount[stream] * dM, f32);

    @fmacs(accum_dsd, accum_dsd, a_dsd, val);
    stream_wcount[stream] += 1;

    if (stream_wcount[stream] == dH) {
        stream_wcount[stream] = 0;
        const global_col = stream * dN_y + stream_colcount[stream];

        // Perform reduction asynchronously
        reduce_async(global_col, stream, buf_idx);

        // Swap buffers for the next column of this stream
        active_buf_idx[stream] = 1 - buf_idx;

        stream_colcount[stream] += 1;
        reduce_count += 1;
        if (reduce_count == @as(i16, kernel_y_dim) * dN_y) {
            terminate_kernel();
        }
    }
}

// Per-stream data tasks [cite: 73-76]
task recv_bcast_0(val: f32) void { handle_bcast(0, val); }
task recv_bcast_1(val: f32) void { handle_bcast(1, val); }
task recv_bcast_2(val: f32) void { handle_bcast(2, val); }
task recv_bcast_3(val: f32) void { handle_bcast(3, val); }
task recv_bcast_4(val: f32) void { handle_bcast(4, val); }
task recv_bcast_5(val: f32) void { handle_bcast(5, val); }
task recv_bcast_6(val: f32) void { handle_bcast(6, val); }
task recv_bcast_7(val: f32) void { handle_bcast(7, val); }

// Optimized: Single DSD send for all B data
task send_b_task() void {
    const b_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &B, .extent = dH * dN_y });
    const out_dsd = @get_dsd(fabout_dsd, .{
        .fabric_color = my_bcast_color,
        .extent = dH * dN_y,
        .output_queue = broadcast_oq,
    });
    // Send entire B buffer asynchronously
    @fmovs(out_dsd, b_dsd, .{ .async = true });
}

// Asynchronous Ring Reduction
fn reduce_async(global_col: i16, stream: i16, buf_idx: i16) void {
    const my_x = @as(i16, layout_mod.get_x_coord());
    const fsum_pe = global_col / dN;
    const isum_pe = (fsum_pe + 1) % kernel_x_dim;
    const local_c_col = global_col - fsum_pe * dN;

    var c_col_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &C, .extent = dM });
    c_col_dsd = @increment_dsd_offset(c_col_dsd, local_c_col * dM, f32);

    var accum_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &accums, .extent = dM });
    accum_dsd = @increment_dsd_offset(accum_dsd, (buf_idx * 8 + stream) * dM, f32);

    // Fabric DSDs [cite: 87-90]
    const fabin_reduce = @get_dsd(fabin_dsd, .{ .fabric_color = reduce_rx_color, .extent = dM, .input_queue = reduce_iq });
    const fabin_flyover = @get_dsd(fabin_dsd, .{ .fabric_color = flyover_color, .extent = dM, .input_queue = flyover_iq });
    const fabout_reduce = @get_dsd(fabout_dsd, .{ .fabric_color = reduce_tx_color, .extent = dM, .output_queue = reduce_oq });
    const fabout_flyover = @get_dsd(fabout_dsd, .{ .fabric_color = flyover_color, .extent = dM, .output_queue = flyover_oq });

    // Execute reduction with .async = true to prevent PE stalls
    if (kernel_x_dim == 1) {
        @fmovs(c_col_dsd, accum_dsd, .{ .async = true });
    } else if (my_x == isum_pe) {
        if (my_x == kernel_x_dim - 1) {
            @fmovs(fabout_flyover, accum_dsd, .{ .async = true });
        } else {
            @fmovs(fabout_reduce, accum_dsd, .{ .async = true });
        }
    } else if (my_x == fsum_pe) {
        if (my_x == 0) {
            @fadds(c_col_dsd, accum_dsd, fabin_flyover, .{ .async = true });
        } else {
            @fadds(c_col_dsd, accum_dsd, fabin_reduce, .{ .async = true });
        }
    } else {
        if (my_x == 0) {
            @fadds(fabout_reduce, accum_dsd, fabin_flyover, .{ .async = true });
        } else if (my_x == kernel_x_dim - 1) {
            @fadds(fabout_flyover, accum_dsd, fabin_reduce, .{ .async = true });
        } else {
            @fadds(fabout_reduce, accum_dsd, fabin_reduce, .{ .async = true });
        }
    }
}

fn broadcast_pe() void {
    timestamp.enable_tsc();
    @activate(send_task_id);
}

fn terminate_kernel() void {
    sys_mod.unblock_cmd_stream();
}

comptime {
    @comptime_assert(@is_arch("wse2"));
    @bind_data_task(recv_bcast_0, @get_data_task_id(bcast_color_0));
    @bind_data_task(recv_bcast_1, @get_data_task_id(bcast_color_1));
    if (kernel_y_dim > 2) { @bind_data_task(recv_bcast_2, @get_data_task_id(bcast_color_2)); }
    if (kernel_y_dim > 3) { @bind_data_task(recv_bcast_3, @get_data_task_id(bcast_color_3)); }
    if (kernel_y_dim > 4) { @bind_data_task(recv_bcast_4, @get_data_task_id(bcast_color_4)); }
    if (kernel_y_dim > 5) { @bind_data_task(recv_bcast_5, @get_data_task_id(bcast_color_5)); }
    if (kernel_y_dim > 6) { @bind_data_task(recv_bcast_6, @get_data_task_id(bcast_color_6)); }
    if (kernel_y_dim > 7) { @bind_data_task(recv_bcast_7, @get_data_task_id(bcast_color_7)); }

    @bind_local_task(send_b_task, send_task_id);
    @export_symbol(ptr_A, "A");
    @export_symbol(ptr_B, "B");
    @export_symbol(ptr_C, "C");
    @export_symbol(broadcast_pe);
}