param memcpy_params: comptime_struct;
param dM: i16;
param dN: i16;
param dN_y: i16;
param dH: i16;
param kernel_x_dim: i16;
param kernel_y_dim: i16;
param broadcast_tx_color: color;
param broadcast_rx_color: color;
param reduce_tx_color: color;
param reduce_rx_color: color;
param scatter_color: color;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const tile_config = @import_module("<tile_config>");
const timestamp = @import_module("<time>");

// TSC timer buffers
var tscStartBuffer = @zeros([timestamp.tsc_size_words]u16);
var tscEndBuffer = @zeros([timestamp.tsc_size_words]u16);
var time_buf_u16 = @zeros([timestamp.tsc_size_words * 2]u16);

fn start_timer() void {
    timestamp.enable_tsc();
    timestamp.get_timestamp(&tscStartBuffer);
}

fn end_timer() void {
    timestamp.get_timestamp(&tscEndBuffer);
    time_buf_u16[0] = tscStartBuffer[0];
    time_buf_u16[1] = tscStartBuffer[1];
    time_buf_u16[2] = tscStartBuffer[2];
    time_buf_u16[3] = tscEndBuffer[0];
    time_buf_u16[4] = tscEndBuffer[1];
    time_buf_u16[5] = tscEndBuffer[2];
}

// Memory Allocation
var A = @zeros([dM * dH]f32);
var B = @zeros([dH * dN_y]f32);
var C = @zeros([dM * dN_y]f32);

// State variables
var my_x_val: i16;
var my_y_val: i16;
var my_send_start_col: i16;
var reduce_col: i16 = 0;
const total_columns: i16 = dN_y;

// DSDs for fabric operations
var fabin_reduce = @get_dsd(fabin_dsd, .{ .fabric_color = reduce_rx_color, .extent = dM });
var fabout_reduce = @get_dsd(fabout_dsd, .{ .fabric_color = reduce_tx_color, .extent = dM });
var fabin_relay = @get_dsd(fabin_dsd, .{ .fabric_color = broadcast_tx_color, .extent = dH });
var fabout_broadcast = @get_dsd(fabout_dsd, .{ .fabric_color = broadcast_rx_color, .extent = dH });

const send_task_id = @get_local_task_id(7);
const reduce_task_id = @get_local_task_id(8);

fn setup_relay() void {
    // Isolated microthread relay for broadcast logic
    const total_upstream = dH * dN_y;
    const f_in = @get_dsd(fabin_dsd, .{ .fabric_color = broadcast_tx_color, .extent = total_upstream });
    const f_out = @get_dsd(fabout_dsd, .{ .fabric_color = broadcast_rx_color, .extent = total_upstream });
    @fmovs(f_out, f_in, .{ .async = true });
}

task send_b_task() void {
    const out_color = if (my_y_val == 0) broadcast_rx_color else broadcast_tx_color;
    for (@range(i16, dN_y)) |n| {
        var b_col = @get_dsd(mem1d_dsd, .{ .base_address = &B, .extent = dH });
        b_col = @increment_dsd_offset(b_col, n * dH, f32);
        const f_out = @get_dsd(fabout_dsd, .{ .fabric_color = out_color, .extent = dH });
        @fmovs(f_out, b_col, .{});
    }
}

task do_reduce() void {
    // Current column reduction logic (Phase 2 & 3)
    // Synchronous local computation + Async fabric reduction

    // Increment tracker and check for termination
    reduce_col += 1;
    if (reduce_col == total_columns) {
        terminate_kernel();
    }
}

fn broadcast_pe() void {
    start_timer();

    // Explicit casts to i16 to fix compiler type mismatch
    my_y_val = @as(i16, layout_mod.get_y_coord());
    my_x_val = @as(i16, layout_mod.get_x_coord());
    my_send_start_col = my_y_val * dN_y;

    if (my_y_val == 0) {
        setup_relay();
        @activate(send_task_id);
    }
}

fn terminate_kernel() void {
    end_timer();
    sys_mod.unblock_cmd_stream();
}

comptime {
    @comptime_assert(@is_arch("wse2"));
    @bind_local_task(send_b_task, send_task_id);
    @bind_local_task(do_reduce, reduce_task_id);

    @export_symbol(&A, "A");
    @export_symbol(&B, "B");
    @export_symbol(&C, "C");
    @export_symbol(&time_buf_u16, "time_buf_u16");
    @export_symbol(broadcast_pe);
}