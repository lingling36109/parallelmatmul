param memcpy_params: comptime_struct;
param dM: i16;
param dN: i16;
param dN_y: i16;
param dH: i16;
param pe_x: i16;
param pe_y: i16;
param kernel_x_dim: i16;
param kernel_y_dim: i16;
param broadcast_tx_color: color;
param broadcast_rx_color: color;
param reduce_tx_color: color;
param reduce_rx_color: color;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const tile_config = @import_module("<tile_config>");
const timestamp = @import_module("<time>");

var tscStartBuffer = @zeros([timestamp.tsc_size_words]u16);
var tscEndBuffer = @zeros([timestamp.tsc_size_words]u16);
var time_buf_u16 = @zeros([timestamp.tsc_size_words * 2]u16);
var ptr_time_buf_u16: [*]u16 = &time_buf_u16;

fn start_timer() void {
  timestamp.enable_tsc();
  timestamp.get_timestamp(&tscStartBuffer);
  time_buf_u16[0] = tscStartBuffer[0];
  time_buf_u16[1] = tscStartBuffer[1];
  time_buf_u16[2] = tscStartBuffer[2];
}

fn end_timer() void {
  timestamp.get_timestamp(&tscEndBuffer);
  time_buf_u16[3] = tscEndBuffer[0];
  time_buf_u16[4] = tscEndBuffer[1];
  time_buf_u16[5] = tscEndBuffer[2];
}

const broadcast_oq: output_queue = @get_output_queue(2);
const reduce_oq: output_queue = @get_output_queue(3);
const reduce_iq: input_queue = @get_input_queue(2);

var A: [dM * dH]f32 = @zeros([dM * dH]f32);
var B: [dH * dN_y]f32 = @zeros([dH * dN_y]f32);
var C: [dM * dN]f32 = @zeros([dM * dN]f32);

var ptr_A: [*]f32 = &A;
var ptr_B: [*]f32 = &B;
var ptr_C: [*]f32 = &C;

var current_row: i16 = 0;
var cols_received: i16 = 0;
var elements_received: i16 = 0;
var cols_sent: i16 = 0;
var reduce_count: i16 = 0;

var red_in: [2 * dM]f32 = @zeros([2 * dM]f32);
var red_idx: i16 = 0;

const send_task_id: local_task_id = @get_local_task_id(10);
const reduce_task_id: local_task_id = @get_local_task_id(11);

var A_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &A, .extent = dM });

// Accelerate Broadcast using @fmovs instead of a software loop
task send_b_task() void {
    var tx_color = broadcast_rx_color;
    if (layout_mod.get_y_coord() == 0) {
        tx_color = broadcast_tx_color;
    }

    var out_dsd = @get_dsd(fabout_dsd, .{ .fabric_color = tx_color, .extent = dH, .output_queue = broadcast_oq });
    var b_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &B[cols_sent * dH], .extent = dH });

    @fmovs(out_dsd, b_dsd, .{ .async = true });
    cols_sent += 1;
}

// Intercepts the upward route and shifts to the downward route
task color_swap_task(data: f32) void {
    var out_dsd = @get_dsd(fabout_dsd, .{ .fabric_color = broadcast_tx_color, .extent = 1, .output_queue = broadcast_oq });
    @mov32(out_dsd, data);
}

task recv_broadcast_task(in_data: f32) void {
    if (elements_received == 0) {
        A_dsd = @set_dsd_base_addr(A_dsd, &A);
        for (@range(u16, dM)) |i| {
            red_in[red_idx * dM + i] = 0.0;
        }
    }

    var red_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &red_in[red_idx * dM], .extent = dM });

    @fmacs(red_dsd, red_dsd, A_dsd, in_data);
    A_dsd = @increment_dsd_offset(A_dsd, dM, f32); // Hardware stride

    elements_received += 1;

    if (elements_received == dH) {
        elements_received = 0;

        @activate(reduce_task_id);
        red_idx = 1 - red_idx; // Double buffering step

        cols_received += 1;
        current_row += 1;
        if (current_row == kernel_y_dim) {
            current_row = 0;
        }

        if (current_row == layout_mod.get_y_coord() and cols_sent < dN_y) {
            @activate(send_task_id);
        }
    }
}

task do_reduce() void {
    const k = reduce_count;
    const fsum_pe = k % kernel_x_dim;
    const isum_pe = (fsum_pe + 1) % kernel_x_dim;
    const pe_x = layout_mod.get_x_coord();

    const finished_idx = 1 - red_idx;
    var completed_red_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &red_in[finished_idx * dM], .extent = dM });

    var out_dsd = @get_dsd(fabout_dsd, .{ .fabric_color = reduce_tx_color, .extent = dM, .output_queue = reduce_oq });
    var in_dsd = @get_dsd(fabin_dsd, .{ .fabric_color = reduce_rx_color, .extent = dM, .input_queue = reduce_iq });

    if (pe_x == isum_pe) {
        @fmovs(out_dsd, completed_red_dsd, .{ .async = true });
    } else if (pe_x == fsum_pe) {
        const my_c_col = k / kernel_x_dim;
        var c_dest_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &C[my_c_col * dM], .extent = dM });
        @fadds(c_dest_dsd, in_dsd, completed_red_dsd, .{ .async = true });
    } else {
        @fadds(out_dsd, in_dsd, completed_red_dsd, .{ .async = true });
    }

    reduce_count += 1;
    if (reduce_count == dN_y * kernel_y_dim) {
        terminate_kernel();
    }
}

fn broadcast_pe() void {
  start_timer();
  if (layout_mod.get_y_coord() == 0) {
      @activate(send_task_id);
  }
}

fn terminate_kernel() void {
  end_timer();
  sys_mod.unblock_cmd_stream();
}

comptime {
    @comptime_assert(@is_arch("wse2"));

  @bind_local_task(send_b_task, send_task_id); [cite: 39]
  @bind_local_task(do_reduce, reduce_task_id); [cite: 39]

  // Use an if/else to ensure only one binding per PE
  if (pe_y == 0) {
      @bind_data_task(color_swap_task, @get_data_task_id(broadcast_rx_color));
  } else {
      @bind_data_task(recv_broadcast_task, @get_data_task_id(broadcast_rx_color));
  }

  @export_symbol(ptr_A, "A"); [cite: 40]
  @export_symbol(ptr_B, "B"); [cite: 40]
  @export_symbol(ptr_C, "C"); [cite: 40]
  @export_symbol(ptr_time_buf_u16, "time_buf_u16"); [cite: 40]
  @export_symbol(broadcast_pe); [cite: 40]
}