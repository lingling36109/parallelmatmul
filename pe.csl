param memcpy_params: comptime_struct;
param dM: i16;
param dN: i16;
param dN_y: i16;
param dH: i16;
param kernel_x_dim: i16;
param kernel_y_dim: i16;
param broadcast_tx_color: color;
param broadcast_rx_color: color;
param reduce_tx_color: color;
param reduce_rx_color: color;
param scatter_color: color;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const tile_config = @import_module("<tile_config>");
const timestamp = @import_module("<time>");

// TSC timer buffers
var tscStartBuffer = @zeros([timestamp.tsc_size_words]u16);
var tscEndBuffer = @zeros([timestamp.tsc_size_words]u16);
var time_buf_u16 = @zeros([timestamp.tsc_size_words * 2]u16);
var ptr_time_buf_u16: [*]u16 = &time_buf_u16;

fn start_timer() void {
    timestamp.enable_tsc();
    timestamp.get_timestamp(&tscStartBuffer);
    time_buf_u16[0] = tscStartBuffer[0];
    time_buf_u16[1] = tscStartBuffer[1];
    time_buf_u16[2] = tscStartBuffer[2];
}

fn end_timer() void {
    timestamp.get_timestamp(&tscEndBuffer);
    time_buf_u16[3] = tscEndBuffer[0];
    time_buf_u16[4] = tscEndBuffer[1];
    time_buf_u16[5] = tscEndBuffer[2];
}

// =============================================================================
// Queue declarations
// =============================================================================
const broadcast_oq: output_queue = @get_output_queue(2);
const broadcast_iq: input_queue = @get_input_queue(3);
const relay_iq: input_queue = @get_input_queue(5);

const reduce_oq: output_queue = @get_output_queue(3);
const reduce_iq: input_queue = @get_input_queue(2);

const flyover_color: color = scatter_color;
const flyover_oq: output_queue = @get_output_queue(4);
const flyover_iq: input_queue = @get_input_queue(4);

// =============================================================================
// Storage
// =============================================================================
var A: [dM * dH]f32 = @zeros([dM * dH]f32);
var B: [dH * dN_y]f32 = @zeros([dH * dN_y]f32);
var C: [dM * dN]f32 = @zeros([dM * dN]f32);

var ptr_A: [*]f32 = &A;
var ptr_B: [*]f32 = &B;
var ptr_C: [*]f32 = &C;

// Double-buffered B column receive buffers
var buf_B_0: [dH]f32 = @zeros([dH]f32);
var buf_B_1: [dH]f32 = @zeros([dH]f32);
const buf_B_0_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &buf_B_0, .extent = dH });
const buf_B_1_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &buf_B_1, .extent = dH });

// Double-buffered reduction accumulators
var red_in_0: [dM]f32 = @zeros([dM]f32);
var red_in_1: [dM]f32 = @zeros([dM]f32);
const red_in_0_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &red_in_0, .extent = dM });
const red_in_1_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &red_in_1, .extent = dM });

// =============================================================================
// DSDs
// =============================================================================
const C_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &C, .extent = dM });

const zeros_buf = @zeros([dM]f32);
const zeros_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &zeros_buf, .extent = dM });

const A_base_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &A, .extent = dM });

// DSD for streaming receive from broadcast fabric
const fabin_broadcast = @get_dsd(fabin_dsd, .{
    .fabric_color = broadcast_rx_color,
    .extent = dH,
    .input_queue = broadcast_iq,
});

// =============================================================================
// State variables
// =============================================================================
var reduce_col: i16 = 0;
var fsum_count: i16 = 0;
var col_count: i16 = 0;
var has_sent: bool = false;
var send_col: i16 = 0;

// Double-buffer selector and reduce tracking
var buf_sel: i16 = 0;
var reduce_clear_sel: i16 = 0;

// Pre-computed values (set in broadcast_pe)
var my_x_val: i16 = 0;
var my_y_val: u16 = 0;
var my_send_start_col: i16 = 0;

// Total columns to process
const total_columns: i16 = @as(i16, kernel_y_dim) * dN_y;

// Task IDs
const send_task_id: local_task_id = @get_local_task_id(11);
const send_done_task_id: local_task_id = @get_local_task_id(12);
const column_done_id: local_task_id = @get_local_task_id(13);
const reduce_done_id: local_task_id = @get_local_task_id(14);

// =============================================================================
// DSD Streaming Receive — target alternate buf_B
// =============================================================================
fn receive_next_column() void {
    if (buf_sel == 0) {
        @fmovs(buf_B_0_dsd, fabin_broadcast, .{ .async = true, .activate = column_done_id });
    } else {
        @fmovs(buf_B_1_dsd, fabin_broadcast, .{ .async = true, .activate = column_done_id });
    }
}

// =============================================================================
// Duplicated GEMV functions (avoid per-iteration branching)
// =============================================================================
fn gemv_0() void {
    var h: i16 = 0;
    while (h < dH) {
        const a_col = @increment_dsd_offset(A_base_dsd, h * dM, f32);
        @fmacs(red_in_0_dsd, red_in_0_dsd, a_col, buf_B_0[h]);
        h += 1;
    }
}

fn gemv_1() void {
    var h: i16 = 0;
    while (h < dH) {
        const a_col = @increment_dsd_offset(A_base_dsd, h * dM, f32);
        @fmacs(red_in_1_dsd, red_in_1_dsd, a_col, buf_B_1[h]);
        h += 1;
    }
}

// =============================================================================
// Column Done Task — GEMV + overlap receive + async reduce
// =============================================================================
task column_done_task() void {
    col_count += 1;

    if (!has_sent) {
        if (col_count >= my_send_start_col) {
            @activate(send_task_id);
        }
    }

    // GEMV: accumulate into red_in[buf_sel] using buf_B[buf_sel]
    if (buf_sel == 0) {
        gemv_0();
    } else {
        gemv_1();
    }

    const reduce_sel = buf_sel;
    buf_sel = 1 - buf_sel;

    // Arm next receive into OTHER buf_B BEFORE reduce (key overlap!)
    if (col_count < total_columns) {
        receive_next_column();
    }

    // Async reduce on the red_in we just filled
    async_reduce(reduce_sel);
}

// =============================================================================
// DSD Streaming Relay — hardware-speed bulk relay at y=0
// =============================================================================
fn setup_relay() void {
    const total_upstream = @as(u16, (@as(i16, kernel_y_dim) - 1) * dH * dN_y);
    const fabin_tx = @get_dsd(fabin_dsd, .{
        .fabric_color = broadcast_tx_color,
        .extent = total_upstream,
        .input_queue = relay_iq,
    });
    const fabout_rx = @get_dsd(fabout_dsd, .{
        .fabric_color = broadcast_rx_color,
        .extent = total_upstream,
        .output_queue = broadcast_oq,
    });
    @fmovs(fabout_rx, fabin_tx, .{ .async = true });
}

// =============================================================================
// Send B Data
// =============================================================================
task send_b_task() void {
    has_sent = true;
    send_col = 0;
    send_next_column();
}

fn send_next_column() void {
    if (send_col >= dN_y) { return; }
    const offset = send_col * dH;
    var b_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &B, .extent = dH });
    b_dsd = @increment_dsd_offset(b_dsd, offset, f32);
    if (my_y_val == 0) {
        const out_dsd = @get_dsd(fabout_dsd, .{
            .fabric_color = broadcast_rx_color,
            .extent = dH,
            .output_queue = broadcast_oq,
        });
        @fmovs(out_dsd, b_dsd, .{ .async = true, .activate = send_done_task_id });
    } else {
        const out_dsd = @get_dsd(fabout_dsd, .{
            .fabric_color = broadcast_tx_color,
            .extent = dH,
            .output_queue = broadcast_oq,
        });
        @fmovs(out_dsd, b_dsd, .{ .async = true, .activate = send_done_task_id });
    }
}

task send_done_task() void {
    send_col += 1;
    if (send_col < dN_y) {
        send_next_column();
    } else if (my_y_val == 0) {
        setup_relay();
    }
}

// =============================================================================
// Async Rotating Ring Reduction
// =============================================================================
fn async_reduce(red_sel: i16) void {
    const my_x = my_x_val;

    const fsum_pe = reduce_col / dN;
    const isum_pe = (fsum_pe + 1) % kernel_x_dim;

    var c_col_dsd = C_dsd;
    c_col_dsd = @increment_dsd_offset(c_col_dsd, fsum_count * dM, f32);

    const red_dsd = if (red_sel == 0) red_in_0_dsd else red_in_1_dsd;
    reduce_clear_sel = red_sel;

    const fabin_reduce = @get_dsd(fabin_dsd, .{
        .fabric_color = reduce_rx_color, .extent = dM, .input_queue = reduce_iq
    });
    const fabin_flyover = @get_dsd(fabin_dsd, .{
        .fabric_color = flyover_color, .extent = dM, .input_queue = flyover_iq
    });
    const fabout_reduce = @get_dsd(fabout_dsd, .{
        .fabric_color = reduce_tx_color, .extent = dM, .output_queue = reduce_oq
    });
    const fabout_flyover = @get_dsd(fabout_dsd, .{
        .fabric_color = flyover_color, .extent = dM, .output_queue = flyover_oq
    });

    if (kernel_x_dim == 1) {
        @fmovs(c_col_dsd, red_dsd, .{ .async = true, .activate = reduce_done_id });
        fsum_count += 1;
    } else if (my_x == isum_pe) {
        if (my_x == kernel_x_dim - 1) {
            @fmovs(fabout_flyover, red_dsd, .{ .async = true, .activate = reduce_done_id });
        } else {
            @fmovs(fabout_reduce, red_dsd, .{ .async = true, .activate = reduce_done_id });
        }
    } else if (my_x == fsum_pe) {
        if (my_x == 0) {
            @fadds(c_col_dsd, red_dsd, fabin_flyover, .{ .async = true, .activate = reduce_done_id });
        } else {
            @fadds(c_col_dsd, red_dsd, fabin_reduce, .{ .async = true, .activate = reduce_done_id });
        }
        fsum_count += 1;
    } else {
        if (my_x == 0) {
            @fadds(fabout_reduce, red_dsd, fabin_flyover, .{ .async = true, .activate = reduce_done_id });
        } else if (my_x == kernel_x_dim - 1) {
            @fadds(fabout_flyover, red_dsd, fabin_reduce, .{ .async = true, .activate = reduce_done_id });
        } else {
            @fadds(fabout_reduce, red_dsd, fabin_reduce, .{ .async = true, .activate = reduce_done_id });
        }
    }

    reduce_col += 1;
}

// =============================================================================
// Reduce Done Task — clear buffer and check termination
// =============================================================================
task reduce_done_task() void {
    if (reduce_clear_sel == 0) {
        @fmovs(red_in_0_dsd, zeros_dsd, .{});
    } else {
        @fmovs(red_in_1_dsd, zeros_dsd, .{});
    }

    if (reduce_col == total_columns) {
        terminate_kernel();
    }
}

// =============================================================================
// Entry point
// =============================================================================
fn broadcast_pe() void {
    start_timer();

    my_y_val = layout_mod.get_y_coord();
    my_x_val = @as(i16, layout_mod.get_x_coord());
    my_send_start_col = @as(i16, my_y_val) * dN_y;

    // Start DSD streaming receive for first B column
    receive_next_column();

    if (my_y_val == 0) {
        @activate(send_task_id);
    }
}

fn terminate_kernel() void {
    end_timer();
    sys_mod.unblock_cmd_stream();
}

comptime {
    @comptime_assert(@is_arch("wse2"));

    @bind_local_task(send_b_task, send_task_id);
    @bind_local_task(send_done_task, send_done_task_id);
    @bind_local_task(column_done_task, column_done_id);
    @bind_local_task(reduce_done_task, reduce_done_id);

    @export_symbol(ptr_A, "A");
    @export_symbol(ptr_B, "B");
    @export_symbol(ptr_C, "C");
    @export_symbol(ptr_time_buf_u16, "time_buf_u16");
    @export_symbol(broadcast_pe);
}
