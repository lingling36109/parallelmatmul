param memcpy_params: comptime_struct;
param dM: i16;
param dN: i16;
param dN_y: i16;
param dH: i16;
param kernel_x_dim: i16;
param kernel_y_dim: i16;
param broadcast_tx_color: color;
param broadcast_rx_color: color;
param reduce_tx_color: color;
param reduce_rx_color: color;
param scatter_color: color;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const tile_config = @import_module("<tile_config>");
const timestamp = @import_module("<time>");

// TSC timer buffers
var tscStartBuffer = @zeros([timestamp.tsc_size_words]u16);
var tscEndBuffer = @zeros([timestamp.tsc_size_words]u16);
var time_buf_u16 = @zeros([timestamp.tsc_size_words * 2]u16);

fn start_timer() void {
    timestamp.enable_tsc();
    timestamp.get_timestamp(&tscStartBuffer);
}

fn end_timer() void {
    timestamp.get_timestamp(&tscEndBuffer);
    time_buf_u16[0] = tscStartBuffer[0];
    time_buf_u16[1] = tscStartBuffer[1];
    time_buf_u16[2] = tscStartBuffer[2];
    time_buf_u16[3] = tscEndBuffer[0];
    time_buf_u16[4] = tscEndBuffer[1];
    time_buf_u16[5] = tscEndBuffer[2];
}

// Local data
var A: [dM * dH]f32 = @zeros([dM * dH]f32);
var B: [dH * dN]f32 = @zeros([dH * dN]f32);
var C: [dM * dN]f32 = @zeros([dM * dN]f32);

// Pointer variables for host-side export
var ptr_A: [*]f32 = &A;
var ptr_B: [*]f32 = &B;
var ptr_C: [*]f32 = &C;
var ptr_time: [*]u16 = &time_buf_u16;

const total_columns: i16 = dN;
var reduce_col: i16 = 0;

var my_x_val: i16;
var my_y_val: i16;
var my_send_start_col: i16;

const broadcast_oq: output_queue = @get_output_queue(1);
const relay_iq: input_queue = @get_input_queue(1);

var send_activated: bool = false;

// Task IDs
const send_task_id: local_task_id = @get_local_task_id(0);
const send_done_task_id: local_task_id = @get_local_task_id(1);
const reduce_done_task_id: local_task_id = @get_local_task_id(2);

// DSDs for computation
var partial_res_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &C, .extent = dM });

fn receive_next_column() void {
    const f_in = @get_dsd(fabin_dsd, .{ .fabric_color = broadcast_rx_color, .extent = dH, .input_queue = relay_iq });
    const b_col_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &B, .extent = dH });
    @fmovs(b_col_dsd, f_in, .{ .async = true, .activate = send_done_task_id });
}

task send_done_task() void {
    // Current column of B is now in memory
    var b_col = @get_dsd(mem1d_dsd, .{ .base_address = &B, .extent = dH });

    // Compute C(:, n) += A * B(:, n)
    for (@range(i16, dH)) |h| {
        var a_col = @get_dsd(mem1d_dsd, .{ .base_address = &A, .extent = dM });
        a_col = @increment_dsd_offset(a_col, h * dM, f32);
        @fmacs(partial_res_dsd, partial_res_dsd, a_col, B[h]);
    }

    // Trigger reduction
    @activate(reduce_done_task_id);
}

fn setup_relay() void {
    const total_upstream = dH;
    const f_in = @get_dsd(fabin_dsd, .{ .fabric_color = broadcast_tx_color, .extent = total_upstream, .input_queue = relay_iq });
    const f_out = @get_dsd(fabout_dsd, .{ .fabric_color = broadcast_rx_color, .extent = total_upstream, .output_queue = broadcast_oq });
    @fmovs(f_out, f_in, .{ .async = true });
}

task send_b_task() void {
    const out_color = if (my_y_val == 0) broadcast_rx_color else broadcast_tx_color;
    for (@range(i16, dN_y)) |n| {
        var b_col = @get_dsd(mem1d_dsd, .{ .base_address = &B, .extent = dH });
        b_col = @increment_dsd_offset(b_col, n * dH, f32);
        const f_out = @get_dsd(fabout_dsd, .{ .fabric_color = out_color, .extent = dH, .output_queue = broadcast_oq });
        @fmovs(f_out, b_col, .{});
    }
}

task do_reduce() void {
    // Synchronous reduction logic
    // Implementation details for FSUM/ISUM/PSUM logic would go here

    reduce_col += 1;
    if (reduce_col == total_columns) {
        terminate_kernel();
    } else {
        receive_next_column();
    }
}

fn broadcast_pe() void {
    start_timer();
    my_y_val = layout_mod.get_y_coord();
    my_x_val = @as(i16, layout_mod.get_x_coord());

    if (my_y_val == 0) {
        setup_relay();
    }

    receive_next_column();

    if (my_y_val == 0) {
        send_activated = true;
        @activate(send_task_id);
    }
}

fn terminate_kernel() void {
    end_timer();
    sys_mod.unblock_cmd_stream();
}

comptime {
    @comptime_assert(@is_arch("wse2"));

    @bind_local_task(send_b_task, send_task_id);
    @bind_local_task(send_done_task, send_done_task_id);
    @bind_local_task(do_reduce, reduce_done_task_id);

    // Export pointers instead of arrays to satisfy compiler requirements
    @export_symbol(ptr_A, "A");
    @export_symbol(ptr_B, "B");
    @export_symbol(ptr_C, "C");
    @export_symbol(ptr_time, "time_buf_u16");

    @export_symbol(broadcast_pe);
}