// Parameters from layout
param memcpy_params: comptime_struct;
param dM: i16;
param dN: i16;
param dN_y: i16;
param dH: i16;
param kernel_x_dim: i16;
param kernel_y_dim: i16;
param my_bcast_color: color;
param reduce_tx_color: color;
param reduce_rx_color: color;
param scatter_color: color;

// Broadcast receive colors (one per PE row, up to 8)
param bcast_color_0: color;
param bcast_color_1: color;
param bcast_color_2: color;
param bcast_color_3: color;
param bcast_color_4: color;
param bcast_color_5: color;
param bcast_color_6: color;
param bcast_color_7: color;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const timestamp = @import_module("<time>");

// =============================================================================
// TSC timer buffers
// =============================================================================
var tscStartBuffer = @zeros([timestamp.tsc_size_words]u16);
var tscEndBuffer = @zeros([timestamp.tsc_size_words]u16);
var time_buf_u16 = @zeros([timestamp.tsc_size_words * 2]u16);
var ptr_time_buf_u16: [*]u16 = &time_buf_u16;

fn start_timer() void {
    timestamp.enable_tsc();
    timestamp.get_timestamp(&tscStartBuffer);
    time_buf_u16[0] = tscStartBuffer[0];
    time_buf_u16[1] = tscStartBuffer[1];
    time_buf_u16[2] = tscStartBuffer[2];
}

fn end_timer() void {
    timestamp.get_timestamp(&tscEndBuffer);
    time_buf_u16[3] = tscEndBuffer[0];
    time_buf_u16[4] = tscEndBuffer[1];
    time_buf_u16[5] = tscEndBuffer[2];
}

// =============================================================================
// Queue declarations
// =============================================================================
const broadcast_oq: output_queue = @get_output_queue(2);
const reduce_oq: output_queue = @get_output_queue(3);
// IQ 0 reused for ring reduce receive after broadcast phase completes (sends_done gate ensures safety)
const reduce_iq: input_queue = @get_input_queue(0);

const flyover_color: color = scatter_color;
const flyover_oq: output_queue = @get_output_queue(4);
// IQ 1 reused for flyover receive after broadcast phase completes
const flyover_iq: input_queue = @get_input_queue(1);

// =============================================================================
// Storage
// =============================================================================
var A: [dM * dH]f32 = @zeros([dM * dH]f32);
var B: [dH * dN_y]f32 = @zeros([dH * dN_y]f32);
var C: [dM * dN]f32 = @zeros([dM * dN]f32);

var ptr_A: [*]f32 = &A;
var ptr_B: [*]f32 = &B;
var ptr_C: [*]f32 = &C;

// Per-stream B column buffer: stores ALL received columns before GEMV
// Layout: b_bufs[stream * dN_y * dH + col * dH + pos]
var b_bufs: [8 * dN_y * dH]f32 = @zeros([8 * dN_y * dH]f32);
// b_buf_wpos removed: bulk fabin DMA receives entire column atomically, no per-element position tracking
var b_buf_col: [8]i16 = @zeros([8]i16);   // which column to receive next (0..dN_y-1)

// Single accumulator for GEMV output
var accum: [dM]f32 = @zeros([dM]f32);
const accum_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &accum, .extent = dM });

// Zero buffer for clearing accumulator
const zeros_buf = @zeros([dM]f32);
const zeros_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &zeros_buf, .extent = dM });

// =============================================================================
// Global state
// =============================================================================
var send_col: i16 = 0;

// Round-robin processing: for each col j, process all sources s=0..kernel_y_dim-1
var proc_source: i16 = 0;
var proc_col: i16 = 0;
var total_reduces_done: i16 = 0;
var gemv_active: bool = false;
var sends_done: bool = false;

// Track how many complete columns each stream has buffered
var stream_cols_ready: [8]i16 = @zeros([8]i16);

// Task IDs
const send_task_id: local_task_id = @get_local_task_id(16);
const reduce_done_task_id: local_task_id = @get_local_task_id(17);
const gemv_task_id: local_task_id = @get_local_task_id(18);
const send_done_task_id: local_task_id = @get_local_task_id(19);

// =============================================================================
// Bulk fabin receive: DMA entire B column directly into b_bufs, no per-wavelet tasks
// =============================================================================

// recv_done task IDs (20-27), declared here so arm_recv can reference them
const recv_done_0_id: local_task_id = @get_local_task_id(20);
const recv_done_1_id: local_task_id = @get_local_task_id(21);
const recv_done_2_id: local_task_id = @get_local_task_id(22);
const recv_done_3_id: local_task_id = @get_local_task_id(23);
const recv_done_4_id: local_task_id = @get_local_task_id(24);
const recv_done_5_id: local_task_id = @get_local_task_id(25);
const recv_done_6_id: local_task_id = @get_local_task_id(26);
const recv_done_7_id: local_task_id = @get_local_task_id(27);

// arm_recv: issue async bulk DMA receive for stream s, current column.
// Each branch uses comptime-constant color and IQ (required by @get_dsd / @get_input_queue).
// IQ = stream index (0..7); fabric delivers dH elements directly into b_bufs.
// IQ 0 and IQ 1 are reused for ring-reduce/flyover after broadcast phase completes.
fn arm_recv(stream: i16) void {
    const col = b_buf_col[stream];
    if (col >= dN_y) return;

    var buf_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &b_bufs, .extent = dH });
    buf_dsd = @increment_dsd_offset(buf_dsd, stream * dN_y * dH + col * dH, f32);

    if (stream == 0) {
        const r = @get_dsd(fabin_dsd, .{ .fabric_color = bcast_color_0, .extent = dH, .input_queue = @get_input_queue(0) });
        @fmovs(buf_dsd, r, .{ .async = true, .activate = recv_done_0_id });
    } else if (stream == 1) {
        const r = @get_dsd(fabin_dsd, .{ .fabric_color = bcast_color_1, .extent = dH, .input_queue = @get_input_queue(1) });
        @fmovs(buf_dsd, r, .{ .async = true, .activate = recv_done_1_id });
    } else if (stream == 2) {
        const r = @get_dsd(fabin_dsd, .{ .fabric_color = bcast_color_2, .extent = dH, .input_queue = @get_input_queue(2) });
        @fmovs(buf_dsd, r, .{ .async = true, .activate = recv_done_2_id });
    } else if (stream == 3) {
        const r = @get_dsd(fabin_dsd, .{ .fabric_color = bcast_color_3, .extent = dH, .input_queue = @get_input_queue(3) });
        @fmovs(buf_dsd, r, .{ .async = true, .activate = recv_done_3_id });
    } else if (stream == 4) {
        const r = @get_dsd(fabin_dsd, .{ .fabric_color = bcast_color_4, .extent = dH, .input_queue = @get_input_queue(4) });
        @fmovs(buf_dsd, r, .{ .async = true, .activate = recv_done_4_id });
    } else if (stream == 5) {
        const r = @get_dsd(fabin_dsd, .{ .fabric_color = bcast_color_5, .extent = dH, .input_queue = @get_input_queue(5) });
        @fmovs(buf_dsd, r, .{ .async = true, .activate = recv_done_5_id });
    } else if (stream == 6) {
        const r = @get_dsd(fabin_dsd, .{ .fabric_color = bcast_color_6, .extent = dH, .input_queue = @get_input_queue(6) });
        @fmovs(buf_dsd, r, .{ .async = true, .activate = recv_done_6_id });
    } else {
        const r = @get_dsd(fabin_dsd, .{ .fabric_color = bcast_color_7, .extent = dH, .input_queue = @get_input_queue(7) });
        @fmovs(buf_dsd, r, .{ .async = true, .activate = recv_done_7_id });
    }
}

fn handle_recv_done(stream: i16) void {
    stream_cols_ready[stream] += 1;
    b_buf_col[stream] += 1;
    arm_recv(stream);  // pre-arm next column DMA
    if (sends_done) { try_start_gemv(); }
}

fn try_start_gemv() void {
    if (gemv_active) return;
    if (proc_source >= kernel_y_dim) return;
    if (stream_cols_ready[proc_source] > 0) {
        gemv_active = true;
        @activate(gemv_task_id);
    }
}

// One completion task per broadcast source (fires when full column DMA'd into b_bufs)
task recv_done_0() void { handle_recv_done(0); }
task recv_done_1() void { handle_recv_done(1); }
task recv_done_2() void { handle_recv_done(2); }
task recv_done_3() void { handle_recv_done(3); }
task recv_done_4() void { handle_recv_done(4); }
task recv_done_5() void { handle_recv_done(5); }
task recv_done_6() void { handle_recv_done(6); }
task recv_done_7() void { handle_recv_done(7); }

// =============================================================================
// GEMV task: process one buffered B column
// =============================================================================
task gemv_task() void {
    const s = proc_source;
    const b_base: u16 = @as(u16, s * dN_y * dH + proc_col * dH);

    // GEMV: accum += A * b_bufs[s, proc_col, :]
    // Precompute base A-column DSD once; increment by dM each iteration
    var a_col_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &A, .extent = dM });
    var h: i16 = 0;
    while (h < dH) : (h += 1) {
        @fmacs(accum_dsd, accum_dsd, a_col_dsd, b_bufs[b_base + @as(u16, h)]);
        if (h + 1 < dH) {
            a_col_dsd = @increment_dsd_offset(a_col_dsd, dM, f32);
        }
    }

    // Launch async ring reduction
    const global_col = s * dN_y + proc_col;
    reduce_async(global_col);
}

// =============================================================================
// Async Ring Reduction
// =============================================================================
fn reduce_async(global_col: i16) void {
    const my_x = @as(i16, layout_mod.get_x_coord());

    const fsum_pe = global_col / dN;
    const isum_pe = (fsum_pe + 1) % kernel_x_dim;
    const local_c_col = global_col - fsum_pe * dN;

    var c_col_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &C, .extent = dM });
    c_col_dsd = @increment_dsd_offset(c_col_dsd, local_c_col * dM, f32);

    const fabin_reduce = @get_dsd(fabin_dsd, .{
        .fabric_color = reduce_rx_color, .extent = dM, .input_queue = reduce_iq
    });
    const fabin_flyover = @get_dsd(fabin_dsd, .{
        .fabric_color = flyover_color, .extent = dM, .input_queue = flyover_iq
    });
    const fabout_reduce = @get_dsd(fabout_dsd, .{
        .fabric_color = reduce_tx_color, .extent = dM, .output_queue = reduce_oq
    });
    const fabout_flyover = @get_dsd(fabout_dsd, .{
        .fabric_color = flyover_color, .extent = dM, .output_queue = flyover_oq
    });

    if (kernel_x_dim == 1) {
        @fmovs(c_col_dsd, accum_dsd, .{ .async = true, .activate = reduce_done_task_id });
    } else if (my_x == isum_pe) {
        if (my_x == kernel_x_dim - 1) {
            @fmovs(fabout_flyover, accum_dsd, .{ .async = true, .activate = reduce_done_task_id });
        } else {
            @fmovs(fabout_reduce, accum_dsd, .{ .async = true, .activate = reduce_done_task_id });
        }
    } else if (my_x == fsum_pe) {
        if (my_x == 0) {
            @fadds(c_col_dsd, accum_dsd, fabin_flyover, .{ .async = true, .activate = reduce_done_task_id });
        } else {
            @fadds(c_col_dsd, accum_dsd, fabin_reduce, .{ .async = true, .activate = reduce_done_task_id });
        }
    } else {
        if (my_x == 0) {
            @fadds(fabout_reduce, accum_dsd, fabin_flyover, .{ .async = true, .activate = reduce_done_task_id });
        } else if (my_x == kernel_x_dim - 1) {
            @fadds(fabout_flyover, accum_dsd, fabin_reduce, .{ .async = true, .activate = reduce_done_task_id });
        } else {
            @fadds(fabout_reduce, accum_dsd, fabin_reduce, .{ .async = true, .activate = reduce_done_task_id });
        }
    }
}

// =============================================================================
// Reduce done: clear accum, advance state, chain to next GEMV
// =============================================================================
task reduce_done_task() void {
    // Clear accumulator
    @fmovs(accum_dsd, zeros_dsd, .{});

    // Consume one ready column from current source
    stream_cols_ready[proc_source] -= 1;

    // Advance processing state (round-robin: cycle sources for each col)
    proc_source += 1;
    if (proc_source >= kernel_y_dim) {
        proc_source = 0;
        proc_col += 1;
    }

    total_reduces_done += 1;
    if (total_reduces_done == @as(i16, kernel_y_dim) * dN_y) {
        terminate_kernel();
        return;
    }

    // Try to start next GEMV
    gemv_active = false;
    try_start_gemv();
}

// =============================================================================
// Send B Data — async send, one column at a time; CE free during fabric I/O
// send_done_task chains to the next column or signals sends complete
// =============================================================================
task send_b_task() void {
    var b_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &B, .extent = dH });
    b_dsd = @increment_dsd_offset(b_dsd, send_col * dH, f32);

    const out_dsd = @get_dsd(fabout_dsd, .{
        .fabric_color = my_bcast_color,
        .extent = dH,
        .output_queue = broadcast_oq,
    });
    send_col += 1;
    @fmovs(out_dsd, b_dsd, .{ .async = true, .activate = send_done_task_id });
}

task send_done_task() void {
    if (send_col < dN_y) {
        @activate(send_task_id);  // send next column; data tasks may run in between
    } else {
        // All sends complete — async microthread released; safe to start reductions
        sends_done = true;
        try_start_gemv();
    }
}

// =============================================================================
// Entry point
// =============================================================================
fn broadcast_pe() void {
    start_timer();

    // Pre-arm bulk fabin DMA for each broadcast source (column 0 of each stream).
    // Must be issued before sends start so IQ hardware captures arriving wavelets.
    arm_recv(0);
    arm_recv(1);
    if (kernel_y_dim > 2) { arm_recv(2); }
    if (kernel_y_dim > 3) { arm_recv(3); }
    if (kernel_y_dim > 4) { arm_recv(4); }
    if (kernel_y_dim > 5) { arm_recv(5); }
    if (kernel_y_dim > 6) { arm_recv(6); }
    if (kernel_y_dim > 7) { arm_recv(7); }

    @activate(send_task_id);  // start async send chain
}

fn terminate_kernel() void {
    end_timer();
    sys_mod.unblock_cmd_stream();
}

comptime {
    @comptime_assert(@is_arch("wse2"));

    // No @bind_data_task: broadcast colors now consumed via bulk fabin_dsd in arm_recv()

    // Bind local tasks
    @bind_local_task(send_b_task, send_task_id);
    @bind_local_task(send_done_task, send_done_task_id);
    @bind_local_task(gemv_task, gemv_task_id);
    @bind_local_task(reduce_done_task, reduce_done_task_id);

    // Bind bulk recv completion tasks (one per source stream)
    @bind_local_task(recv_done_0, recv_done_0_id);
    @bind_local_task(recv_done_1, recv_done_1_id);
    if (kernel_y_dim > 2) { @bind_local_task(recv_done_2, recv_done_2_id); }
    if (kernel_y_dim > 3) { @bind_local_task(recv_done_3, recv_done_3_id); }
    if (kernel_y_dim > 4) { @bind_local_task(recv_done_4, recv_done_4_id); }
    if (kernel_y_dim > 5) { @bind_local_task(recv_done_5, recv_done_5_id); }
    if (kernel_y_dim > 6) { @bind_local_task(recv_done_6, recv_done_6_id); }
    if (kernel_y_dim > 7) { @bind_local_task(recv_done_7, recv_done_7_id); }

    @export_symbol(ptr_A, "A");
    @export_symbol(ptr_B, "B");
    @export_symbol(ptr_C, "C");
    @export_symbol(ptr_time_buf_u16, "time_buf_u16");
    @export_symbol(broadcast_pe);
}
