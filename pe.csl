param memcpy_params: comptime_struct;
param dM: i16;
param dH: i16;
param dN: i16;
param my_bcast_color: color;

param b0: color; param b1: color; param b2: color; param b3: color;
param b4: color; param b5: color; param b6: color; param b7: color;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const timestamp = @import_module("<time>");

var B = @zeros([dH * dN]f32);
var C = @zeros([dM * dN]f32);
var time_buf = @zeros([6]u16);
var ptr_time_buf: [*]u16 = &time_buf;

// Use Task ID 30 to avoid overlap with color-mapped task IDs
const send_task_id: local_task_id = @get_local_task_id(30);

const out_dsd = @get_dsd(fabout_dsd, .{
    .extent = dN,
    .fabric_color = my_bcast_color,
    .output_queue = @get_output_queue(1)
});

const b_mem_dsd = @get_dsd(mem1d_dsd, .{
    .tensor_access = |i|{dH * dN} -> B[i]
});

task send_b_task() void {
    @mov32(out_dsd, b_mem_dsd);
}

// Data tasks for receiving broadcasts
task r0(data: f32) void { C[0] += data; }
task r1(data: f32) void { C[0] += data; }
task r2(data: f32) void { C[0] += data; }
task r3(data: f32) void { C[0] += data; }
task r4(data: f32) void { C[0] += data; }
task r5(data: f32) void { C[0] += data; }
task r6(data: f32) void { C[0] += data; }
task r7(data: f32) void { C[0] += data; }

fn broadcast_pe() void {
    timestamp.get_tsc(ptr_time_buf);
    @activate(send_task_id);
}

fn terminate_kernel() void {
    timestamp.get_tsc(ptr_time_buf + 3);
    sys_mod.unblock_cmd_stream();
}

comptime {
    @bind_local_task(send_b_task, send_task_id);

    @bind_data_task(r0, @get_data_task_id(b0));
    @bind_data_task(r1, @get_data_task_id(b1));
    @bind_data_task(r2, @get_data_task_id(b2));
    @bind_data_task(r3, @get_data_task_id(b3));
    @bind_data_task(r4, @get_data_task_id(b4));
    @bind_data_task(r5, @get_data_task_id(b5));
    @bind_data_task(r6, @get_data_task_id(b6));
    @bind_data_task(r7, @get_data_task_id(b7));

    @export_symbol(ptr_time_buf, "time_buf_u16");
    @export_symbol(broadcast_pe);
    @export_symbol(terminate_kernel);
}