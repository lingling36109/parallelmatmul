// pe.csl
param memcpy_params: comptime_struct;
param dM: i16; param dN: i16; param dN_y: i16; param dH: i16;
param kernel_x_dim: i16; param kernel_y_dim: i16;
param broadcast_color: color;
param reduce_color: color;
param sync_color: color;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const layout_mod = @import_module("<layout>");
const timestamp = @import_module("<time>");

var A: [dM * dH]f32;
var B: [dH * dN_y]f32;
var C: [dM * dN]f32 = @zeros([dM * dN]f32);
var red_in: [dM]f32 = @zeros([dM]f32);
const zeros_buf = @zeros([dM]f32);

// Store-then-compute buffer for received B column
var buf_B: [dH]f32;

// Sync wavelet source buffer
var sync_buf: [1]f32 = @zeros([1]f32);

var ptr_A: [*]f32 = &A;
var ptr_B: [*]f32 = &B;
var ptr_C: [*]f32 = &C;

var time_buf_u16 = @zeros([timestamp.tsc_size_words * 2]u16);
var ptr_time_buf_u16: [*]u16 = &time_buf_u16;

const send_task_id: local_task_id = @get_local_task_id(11);
const recv_task_id: data_task_id = @get_data_task_id(broadcast_color);
const reduce_task_id: data_task_id = @get_data_task_id(reduce_color);
const sync_task_id: data_task_id = @get_data_task_id(sync_color);

var send_col: i16 = 0;
var h_idx: i16 = 0;
var n_idx: i16 = 0;
var reduce_cnt: i16 = 0;

task send_b_task() void {
    if (send_col >= dN_y) return;
    const out_dsd = @get_dsd(fabout_dsd, .{
        .fabric_color = broadcast_color,
        .extent = dH,
        .output_queue = @get_output_queue(2)
    });
    const b_ptr = @increment_dsd_offset(
        @get_dsd(mem1d_dsd, .{ .base_address = &B, .extent = dH }),
        send_col * dH, f32
    );
    @fmovs(out_dsd, b_ptr, .{ .async = true });
    send_col += 1;
}

// Store-then-compute: store each wavelet (~1 cycle), then GEMV after full column
task recv_b_task(wavelet: f32) void {
    buf_B[h_idx] = wavelet;
    h_idx += 1;

    if (h_idx == dH) {
        h_idx = 0;

        // GEMV: red_in += A * buf_B (unrolled by --max-inlined-iterations)
        const red_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &red_in, .extent = dM });
        var h: i16 = 0;
        while (h < dH) {
            const a_col_dsd = @increment_dsd_offset(
                @get_dsd(mem1d_dsd, .{ .base_address = &A, .extent = dM }),
                h * dM, f32
            );
            @fmacs(red_dsd, red_dsd, a_col_dsd, buf_B[h]);
            h += 1;
        }

        // Store own partial result into C
        const c_dsd = @increment_dsd_offset(
            @get_dsd(mem1d_dsd, .{ .base_address = &C, .extent = dM }),
            n_idx * dM, f32
        );
        @fmovs(c_dsd, red_dsd, .{});

        if (layout_mod.get_x_coord() == @as(u16, kernel_x_dim - 1)) {
            // Rightmost PE: send partial on reduce synchronously, then clean up
            const out_red = @get_dsd(fabout_dsd, .{
                .fabric_color = reduce_color,
                .extent = dM,
                .output_queue = @get_output_queue(3)
            });
            @fmovs(out_red, red_dsd, .{});

            // Clear red_in for next column
            @fmovs(red_dsd,
                   @get_dsd(mem1d_dsd, .{ .base_address = &zeros_buf, .extent = dM }), .{});

            n_idx += 1;

            // Send sync wavelet
            const sync_out = @get_dsd(fabout_dsd, .{
                .fabric_color = sync_color,
                .extent = 1,
                .output_queue = @get_output_queue(4)
            });
            @fmovs(sync_out,
                   @get_dsd(mem1d_dsd, .{ .base_address = &sync_buf, .extent = 1 }),
                   .{ .async = true });

            if (n_idx == dN_y) {
                terminate_kernel();
            }
        }
        // Non-rightmost PEs: reduce_task handles the rest
    }
}

task reduce_task(val: f32) void {
    // Accumulate incoming eastern partial into C
    C[n_idx * dM + reduce_cnt] += val;
    reduce_cnt += 1;

    if (reduce_cnt == dM) {
        reduce_cnt = 0;
        n_idx += 1;

        // Clear red_in for next column
        @fmovs(@get_dsd(mem1d_dsd, .{ .base_address = &red_in, .extent = dM }),
               @get_dsd(mem1d_dsd, .{ .base_address = &zeros_buf, .extent = dM }), .{});

        // Send sync wavelet
        const sync_out = @get_dsd(fabout_dsd, .{
            .fabric_color = sync_color,
            .extent = 1,
            .output_queue = @get_output_queue(4)
        });
        @fmovs(sync_out,
               @get_dsd(mem1d_dsd, .{ .base_address = &sync_buf, .extent = 1 }),
               .{ .async = true });

        if (n_idx == dN_y) {
            terminate_kernel();
        }
    }
}

task sync_task(wavelet: f32) void {
    @activate(send_task_id);
}

fn broadcast_pe() void {
    timestamp.enable_tsc();
    timestamp.get_timestamp(@ptrcast(*[3]u16, &time_buf_u16[0]));
    if (layout_mod.get_y_coord() == 0) {
        @activate(send_task_id);
    }
}

fn terminate_kernel() void {
    timestamp.get_timestamp(@ptrcast(*[3]u16, &time_buf_u16[3]));
    sys_mod.unblock_cmd_stream();
}

comptime {
    @bind_local_task(send_b_task, send_task_id);
    @bind_data_task(recv_b_task, recv_task_id);
    @bind_data_task(reduce_task, reduce_task_id);
    @bind_data_task(sync_task, sync_task_id);

    @export_symbol(ptr_A, "A");
    @export_symbol(ptr_B, "B");
    @export_symbol(ptr_C, "C");
    @export_symbol(ptr_time_buf_u16, "time_buf_u16");
    @export_symbol(broadcast_pe);
}
