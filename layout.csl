// layout.csl
param kernel_x_dim: i16;
param kernel_y_dim: i16;
param M: i16;
param H: i16;
param N: i16;

// IDs for memcpy streaming colors
param MEMCPYH2D_DATA_1_ID: i16;
param MEMCPYH2D_DATA_2_ID: i16;
param MEMCPYD2H_DATA_1_ID: i16;

// Colors
const MEMCPYH2D_DATA_1: color = @get_color(MEMCPYH2D_DATA_1_ID);
const MEMCPYH2D_DATA_2: color = @get_color(MEMCPYH2D_DATA_2_ID);
const MEMCPYD2H_DATA_1: color = @get_color(MEMCPYD2H_DATA_1_ID);

const broadcast_color: color = @get_color(0);
const reduce_color: color    = @get_color(1);
const sync_color: color      = @get_color(2); // New color for flow control

const memcpy = @import_module("<memcpy/get_params>", .{
    .width = kernel_x_dim,
    .height = kernel_y_dim,
    .MEMCPYH2D_1 = MEMCPYH2D_DATA_1,
    .MEMCPYH2D_2 = MEMCPYH2D_DATA_2,
    .MEMCPYD2H_1 = MEMCPYD2H_DATA_1
});

layout {
    @set_rectangle(kernel_x_dim, kernel_y_dim);

    const common_params = .{
        .dM = M / kernel_y_dim,
        .dH = H,
        .dN = N / kernel_x_dim,
        .dN_y = N / kernel_x_dim,
        .kernel_x_dim = kernel_x_dim,
        .kernel_y_dim = kernel_y_dim,
    };

    for (let pe_x: i16 = 0; pe_x < kernel_x_dim; pe_x += 1) {
        for (let pe_y: i16 = 0; pe_y < kernel_y_dim; pe_y += 1) {
            @set_tile_code(pe_x, pe_y, "pe.csl", @concat_structs(
                common_params,
                .{
                    .memcpy_params = memcpy.get_params(pe_x),
                    .broadcast_color = broadcast_color,
                    .reduce_color = reduce_color,
                    .sync_color = sync_color,
                }
            ));

            // --- Broadcast Routing (North -> South) ---
            const b_routes = if (pe_y == 0)
                .{ .rx = .{RAMP}, .tx = .{SOUTH, RAMP} }
            else if (pe_y == kernel_y_dim - 1)
                .{ .rx = .{NORTH}, .tx = .{RAMP} }
            else
                .{ .rx = .{NORTH}, .tx = .{SOUTH, RAMP} };
            @set_color_config(pe_x, pe_y, broadcast_color, .{ .routes = b_routes });

            // --- Reduction Routing (East -> West) ---
            const r_routes = if (pe_x == kernel_x_dim - 1)
                .{ .rx = .{RAMP}, .tx = .{WEST} }
            else if (pe_x == 0)
                .{ .rx = .{EAST}, .tx = .{RAMP} }
            else
                .{ .rx = .{EAST}, .tx = .{WEST, RAMP} };
            @set_color_config(pe_x, pe_y, reduce_color, .{ .routes = r_routes });

            // --- Sync Routing (South -> North) ---
            const s_routes = if (pe_y == kernel_y_dim - 1)
                .{ .rx = .{RAMP}, .tx = .{NORTH} }
            else if (pe_y == 0)
                .{ .rx = .{SOUTH}, .tx = .{RAMP} }
            else
                .{ .rx = .{SOUTH}, .tx = .{NORTH} };
            @set_color_config(pe_x, pe_y, sync_color, .{ .routes = s_routes });
        }
    }

    // --- External Routes ---
    for (let pe_x: i16 = 0; pe_x < kernel_x_dim; pe_x += 1) {
        @set_color_config(pe_x, 0, MEMCPYH2D_DATA_1, .{ .routes = .{ .rx = .{NORTH}, .tx = .{RAMP} } });
        @set_color_config(pe_x, 0, MEMCPYH2D_DATA_2, .{ .routes = .{ .rx = .{NORTH}, .tx = .{RAMP} } });
        @set_color_config(pe_x, 0, MEMCPYD2H_DATA_1, .{ .routes = .{ .rx = .{RAMP}, .tx = .{NORTH} } });
    }
}