// Color map
//  ID var                   ID var  ID var               ID var
//   0 (unused)              9  bc1  18                   27 reserved (memcpy)
//   1 (unused)              10 bc2  19                   28 reserved (memcpy)
//   2 MEMCPYH2D_1           11 bc3  20                   29 reserved
//   3 MEMCPYH2D_2           12 bc4  21 reserved (memcpy) 30 reserved (memcpy)
//   4 MEMCPYD2H_1           13 bc5  22 reserved (memcpy) 31 reserved
//   5 reduce_A_color        14 bc6  23 reserved (memcpy) 32
//   6 reduce_B_color        15 bc7  24                   33
//   7 reduce_C_color        16      25                   34
//   8 bc0                   17      26                   35


// IDs for memcpy streaming colors
param MEMCPYH2D_DATA_1_ID: i16;
param MEMCPYH2D_DATA_2_ID: i16;
param MEMCPYD2H_DATA_1_ID: i16;

// Colors
const MEMCPYH2D_DATA_1: color = @get_color(MEMCPYH2D_DATA_1_ID);
const MEMCPYH2D_DATA_2: color = @get_color(MEMCPYH2D_DATA_2_ID);
const MEMCPYD2H_DATA_1: color = @get_color(MEMCPYD2H_DATA_1_ID);

// Kernel dimensions
param kernel_x_dim: i16;
param kernel_y_dim: i16;

// Matrix dimensions
param M: i16;
param H: i16;
param N: i16;

const x_color_0: color = @get_color(8);
const x_color_1: color = @get_color(9);
const x_color_2: color = @get_color(10);
const x_color_3: color = @get_color(11);
const x_color_4: color = @get_color(12);
const x_color_5: color = @get_color(13);
const x_color_6: color = @get_color(14);
const x_color_7: color = @get_color(15);

const reduce_A_color: color = @get_color(5);
const reduce_B_color: color = @get_color(6);
const reduce_C_color: color = @get_color(7);

const memcpy = @import_module("<memcpy/get_params>", .{
    .width = kernel_x_dim,
    .height = kernel_y_dim,
    .MEMCPYH2D_1 = MEMCPYH2D_DATA_1,
    .MEMCPYH2D_2 = MEMCPYH2D_DATA_2,
    .MEMCPYD2H_1 = MEMCPYD2H_DATA_1
});

layout {
    @set_struct_id(0);

    for (@range(i16, kernel_x_dim)) |pe_x| {
        for (@range(i16, kernel_y_dim)) |pe_y| {
            const my_bcast_color = @get_color(8 + pe_y);

            // Compute routing: All PEs in a column receive from all row colors
            // This enables the "Simultaneous Broadcast" from your plan
            @set_color_config(pe_x, pe_y, x_color_0, .{ .routes = .{ .rx = .{NORTH}, .tx = .{RAMP, SOUTH} } });
            @set_color_config(pe_x, pe_y, x_color_1, .{ .routes = .{ .rx = .{NORTH}, .tx = .{RAMP, SOUTH} } });
            @set_color_config(pe_x, pe_y, x_color_2, .{ .routes = .{ .rx = .{NORTH}, .tx = .{RAMP, SOUTH} } });
            @set_color_config(pe_x, pe_y, x_color_3, .{ .routes = .{ .rx = .{NORTH}, .tx = .{RAMP, SOUTH} } });

            @set_tile_code(pe_x, pe_y, "pe.csl", .{
                .memcpy_params = memcpy.get_params(pe_x),
                .dM = M / kernel_y_dim,
                .dH = H / kernel_x_dim,
                .dN = N / kernel_x_dim,
                .dN_y = N / kernel_y_dim,
                .kernel_x_dim = kernel_x_dim,
                .kernel_y_dim = kernel_y_dim,
                .my_bcast_color = my_bcast_color,
                .reduce_tx_color = reduce_A_color,
                .reduce_rx_color = reduce_B_color,
                .scatter_color = reduce_C_color,
                .bcast_color_0 = x_color_0,
                .bcast_color_1 = x_color_1,
                .bcast_color_2 = x_color_2,
                .bcast_color_3 = x_color_3,
                .bcast_color_4 = x_color_4,
                .bcast_color_5 = x_color_5,
                .bcast_color_6 = x_color_6,
                .bcast_color_7 = x_color_7,
            });
        }
    }

    // Explicitly set the host-to-device and device-to-host regions
    @set_comm_master_reg_region(0, 0, kernel_x_dim, kernel_y_dim);
}