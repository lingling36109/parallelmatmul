// Color map
//  ID var                   ID var  ID var               ID var
//   0 (unused)              9  bc1  18                   27 reserved (memcpy)
//   1 (unused)              10 bc2  19                   28 reserved (memcpy)
//   2 MEMCPYH2D_1           11 bc3  20                   29 reserved
//   3 MEMCPYH2D_2           12 bc4  21 reserved (memcpy) 30 reserved (memcpy)
//   4 MEMCPYD2H_1           13 bc5  22 reserved (memcpy) 31 reserved
//   5 reduce_A_color        14 bc6  23 reserved (memcpy) 32
//   6 reduce_B_color        15 bc7  24                   33
//   7 reduce_C_color        16      25                   34
//   8 bc0                   17      26                   35
// Color IDs
param MEMCPYH2D_DATA_1_ID: i16;
param MEMCPYH2D_DATA_2_ID: i16;
param MEMCPYD2H_DATA_1_ID: i16;

const MEMCPYH2D_DATA_1: color = @get_color(MEMCPYH2D_DATA_1_ID);
const MEMCPYH2D_DATA_2: color = @get_color(MEMCPYH2D_DATA_2_ID);
const MEMCPYD2H_DATA_1: color = @get_color(MEMCPYD2H_DATA_1_ID);

param kernel_x_dim: i16;
param kernel_y_dim: i16;
param M: i16;
param H: i16;
param N: i16;

// Broadcast colors (8-15)
const x_col0: color = @get_color(8);
const x_col1: color = @get_color(9);
const x_col2: color = @get_color(10);
const x_col3: color = @get_color(11);
const x_col4: color = @get_color(12);
const x_col5: color = @get_color(13);
const x_col6: color = @get_color(14);
const x_col7: color = @get_color(15);

const memcpy = @import_module("<memcpy/get_params>", .{
    .width = kernel_x_dim,
    .height = kernel_y_dim,
    .MEMCPYH2D_1 = MEMCPYH2D_DATA_1,
    .MEMCPYH2D_2 = MEMCPYH2D_DATA_2,
    .MEMCPYD2H_1 = MEMCPYD2H_DATA_1
});

layout {
    for (@range(i16, kernel_x_dim)) |pe_x| {
        for (@range(i16, kernel_y_dim)) |pe_y| {

            // 1. Identify which color THIS row uses to broadcast
            const my_color = @get_color(8 + pe_y);

            // 2. Configure routing for ALL possible broadcast colors in the column
            // We use a simple North-to-South flow for all broadcast colors
            @set_color_config(pe_x, pe_y, x_col0, .{ .routes = .{ .rx = .{NORTH}, .tx = .{RAMP, SOUTH} } });
            @set_color_config(pe_x, pe_y, x_col1, .{ .routes = .{ .rx = .{NORTH}, .tx = .{RAMP, SOUTH} } });
            @set_color_config(pe_x, pe_y, x_col2, .{ .routes = .{ .rx = .{NORTH}, .tx = .{RAMP, SOUTH} } });
            @set_color_config(pe_x, pe_y, x_col3, .{ .routes = .{ .rx = .{NORTH}, .tx = .{RAMP, SOUTH} } });
            @set_color_config(pe_x, pe_y, x_col4, .{ .routes = .{ .rx = .{NORTH}, .tx = .{RAMP, SOUTH} } });
            @set_color_config(pe_x, pe_y, x_col5, .{ .routes = .{ .rx = .{NORTH}, .tx = .{RAMP, SOUTH} } });
            @set_color_config(pe_x, pe_y, x_col6, .{ .routes = .{ .rx = .{NORTH}, .tx = .{RAMP, SOUTH} } });
            @set_color_config(pe_x, pe_y, x_col7, .{ .routes = .{ .rx = .{NORTH}, .tx = .{RAMP, SOUTH} } });

            // 3. Assign code to the PE
            @set_tile_code(pe_x, pe_y, "pe.csl", .{
                .memcpy_params = memcpy.get_params(pe_x),
                .dM = M / kernel_y_dim,
                .dH = H / kernel_x_dim,
                .dN = N / kernel_x_dim,
                .kernel_x_dim = kernel_x_dim,
                .kernel_y_dim = kernel_y_dim,
                .my_bcast_color = my_color,
                .bcast_color_0 = x_col0,
                .bcast_color_1 = x_col1,
                .bcast_color_2 = x_col2,
                .bcast_color_3 = x_col3,
                .bcast_color_4 = x_col4,
                .bcast_color_5 = x_col5,
                .bcast_color_6 = x_col6,
                .bcast_color_7 = x_col7
            });
        }
    }

    @set_comm_master_reg_region(0, 0, kernel_x_dim, kernel_y_dim);
}