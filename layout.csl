// Color map (2-color broadcast via head PE CE reflector)
//  ID var                   ID var       ID var               ID var
//   0 bcast_rx_color        9  (free)   18                   27 reserved (memcpy)
//   1 bcast_tx_color        10 (free)   19                   28 reserved (memcpy)
//   2 MEMCPYH2D_1           11 (free)   20                   29 reserved
//   3 MEMCPYH2D_2           12 (free)   21 reserved (memcpy) 30 reserved (memcpy)
//   4 MEMCPYD2H_1           13 (free)   22 reserved (memcpy) 31 reserved
//   5 reduce_A_color        14 (free)   23 reserved (memcpy) 32
//   6 reduce_B_color        15 (free)   24                   33
//   7 reduce_C_color        16          25                   34
//   8 (free)                17          26                   35


// IDs for memcpy streaming colors
param MEMCPYH2D_DATA_1_ID: i16;
param MEMCPYH2D_DATA_2_ID: i16;
param MEMCPYD2H_DATA_1_ID: i16;

// Colors
const MEMCPYH2D_DATA_1: color = @get_color(MEMCPYH2D_DATA_1_ID);
const MEMCPYH2D_DATA_2: color = @get_color(MEMCPYH2D_DATA_2_ID);
const MEMCPYD2H_DATA_1: color = @get_color(MEMCPYD2H_DATA_1_ID);

// Kernel dimensions
param kernel_x_dim: i16;
param kernel_y_dim: i16;

// Total matrix dimensions
param M: i16;
param H: i16;
param N: i16;

// Reduction colors: three colors for interleaved ring reduction
const reduce_A_color: color = @get_color(5);
const reduce_B_color: color = @get_color(6);
const reduce_C_color: color = @get_color(7);

// Broadcast: 2 colors
//   bcast_tx_color: PEs send B-segments UP to head PE (pe_y=0)
//   bcast_rx_color: Head PE CE-relay broadcasts DOWN to all PEs
const bcast_tx_color: color = @get_color(1);
const bcast_rx_color: color = @get_color(0);

// Memcpy infrastructure (provided)
const memcpy = @import_module("<memcpy/get_params>", .{
  .width = kernel_x_dim,
  .height = kernel_y_dim,
  .MEMCPYH2D_1 = MEMCPYH2D_DATA_1,
  .MEMCPYH2D_2 = MEMCPYH2D_DATA_2,
  .MEMCPYD2H_1 = MEMCPYD2H_DATA_1
});

layout {
  // PE coordinates are (column, row)
  @set_rectangle(kernel_x_dim, kernel_y_dim);

  @comptime_assert(M % kernel_y_dim == 0);
  @comptime_assert(H % kernel_x_dim == 0);
  @comptime_assert(N % kernel_y_dim == 0);
  @comptime_assert(N % kernel_x_dim == 0);
  @comptime_assert(kernel_x_dim >= 2);
  @comptime_assert(kernel_y_dim >= 2);
  @comptime_assert(kernel_y_dim <= 8);

  const common_params = .{
    .dM = M / kernel_y_dim,
    .dN = N / kernel_x_dim,
    .dN_y = N / kernel_y_dim,
    .dH = H / kernel_x_dim,
    .kernel_x_dim = kernel_x_dim,
    .kernel_y_dim = kernel_y_dim,
    .bcast_tx_color = bcast_tx_color,
    .bcast_rx_color = bcast_rx_color,
  };

  for (@range(i16, kernel_x_dim)) |pe_x| {
    for (@range(i16, kernel_y_dim)) |pe_y| {

// --- Set tile code with checkerboard reduce colors ---
if (pe_x % 2 == 0) {
  @set_tile_code(pe_x, pe_y, "pe.csl", @concat_structs(
    common_params,
    .{
      .memcpy_params = memcpy.get_params(pe_x),
      .my_x = @as(i16, pe_x), // Pass X coordinate
      .my_y = @as(i16, pe_y), // Pass Y coordinate
      .reduce_tx_color = reduce_A_color,
      .reduce_rx_color = reduce_B_color,
      .scatter_color = reduce_C_color,
    },
  ));
} else {
  @set_tile_code(pe_x, pe_y, "pe.csl", @concat_structs(
    common_params,
    .{
      .memcpy_params = memcpy.get_params(pe_x),
      .my_x = @as(i16, pe_x), // Pass X coordinate
      .my_y = @as(i16, pe_y), // Pass Y coordinate
      .reduce_tx_color = reduce_B_color,
      .reduce_rx_color = reduce_A_color,
      .scatter_color = reduce_C_color,
    },
  ));
}

      // =================================================================
      // Broadcast TX routing (bcast_tx_color): PEs send B-segments NORTH
      //
      // Head PE (pe_y=0):
      //   Receives from RAMP (self-send) or SOUTH (forwarded from below)
      //   Delivers to RAMP for CE reflector (head_reflector_task)
      //   Switches: pos1=RAMP (head is source), pos2=SOUTH (other PE is source)
      //   SWITCH_ADV toggles between pos1 and pos2 at each source change
      //
      // Other PEs:
      //   Receives from RAMP (self-send) or SOUTH (forwarding from below)
      //   Forwards NORTH toward head PE
      // =================================================================
      if (pe_y == 0) {
        // Head PE: terminate TX at RAMP (CE reflector reads from here)
        @set_color_config(pe_x, pe_y, bcast_tx_color, .{
          .routes = .{ .rx = .{RAMP, SOUTH}, .tx = .{RAMP} },
          .switches = .{ .pos1 = .{ .rx = RAMP }, .pos2 = .{ .rx = SOUTH } },
        });
      } else {
        // Non-head PE: forward from RAMP/SOUTH to NORTH
        @set_color_config(pe_x, pe_y, bcast_tx_color, .{
          .routes = .{ .rx = .{RAMP, SOUTH}, .tx = .{NORTH} },
        });
      }

      // =================================================================
      // Broadcast RX routing (bcast_rx_color): head PE CE-relay broadcasts DOWN
      //
      // Head PE (pe_y=0):
      //   Receives from RAMP (CE reflector writes here)
      //   Broadcasts SOUTH + self-deliver via RAMP (for head PE's own GEMV)
      //
      // Other PEs:
      //   Receives from NORTH
      //   Forwards SOUTH + delivers to RAMP (for GEMV)
      // =================================================================
      if (pe_y == 0) {
        // Head PE: CE reflector sends here, broadcasts SOUTH + self-receive
        @set_color_config(pe_x, pe_y, bcast_rx_color, .{
          .routes = .{ .rx = .{RAMP}, .tx = .{SOUTH, RAMP} },
        });
      } else if (pe_y == kernel_y_dim - 1) {
        // Bottom PE: terminal — deliver to RAMP only
        @set_color_config(pe_x, pe_y, bcast_rx_color, .{
          .routes = .{ .rx = .{NORTH}, .tx = .{RAMP} },
        });
      } else {
        // Middle PE: forward SOUTH + deliver to RAMP
        @set_color_config(pe_x, pe_y, bcast_rx_color, .{
          .routes = .{ .rx = .{NORTH}, .tx = .{SOUTH, RAMP} },
        });
      }

      // =================================================================
      // Reduction EAST chain routing (checkerboard) — unchanged
      // =================================================================
      if (pe_x % 2 == 0) {
        @set_color_config(pe_x, pe_y, reduce_A_color, .{
          .routes = .{ .rx = .{RAMP}, .tx = .{EAST} },
        });
        @set_color_config(pe_x, pe_y, reduce_B_color, .{
          .routes = .{ .rx = .{WEST}, .tx = .{RAMP} },
        });
      } else {
        @set_color_config(pe_x, pe_y, reduce_B_color, .{
          .routes = .{ .rx = .{RAMP}, .tx = .{EAST} },
        });
        @set_color_config(pe_x, pe_y, reduce_A_color, .{
          .routes = .{ .rx = .{WEST}, .tx = .{RAMP} },
        });
      }

      // =================================================================
      // Scatter WEST routing (reduce_C_color) — unchanged
      // =================================================================
      if (pe_x == kernel_x_dim - 1) {
        @set_color_config(pe_x, pe_y, reduce_C_color, .{
          .routes = .{ .rx = .{RAMP}, .tx = .{WEST} },
        });
      } else if (pe_x == 0) {
        @set_color_config(pe_x, pe_y, reduce_C_color, .{
          .routes = .{ .rx = .{EAST}, .tx = .{RAMP} },
        });
      } else {
        @set_color_config(pe_x, pe_y, reduce_C_color, .{
          .routes = .{ .rx = .{EAST}, .tx = .{WEST} },
        });
      }
    }
  }

  // Export symbol names
  @export_name("A", [*]f32, true);
  @export_name("B", [*]f32, true);
  @export_name("C", [*]f32, true);
  @export_name("time_buf_u16", [*]u16, true);
  @export_name("broadcast_pe", fn () void);
}
