param MEMCPYH2D_DATA_1_ID: i16;
param MEMCPYH2D_DATA_2_ID: i16;
param MEMCPYD2H_DATA_1_ID: i16;

const MEMCPYH2D_DATA_1: color = @get_color(MEMCPYH2D_DATA_1_ID);
const MEMCPYH2D_DATA_2: color = @get_color(MEMCPYH2D_DATA_2_ID);
const MEMCPYD2H_DATA_1: color = @get_color(MEMCPYD2H_DATA_1_ID);

param kernel_x_dim: i16;
param kernel_y_dim: i16;

param M: i16;
param H: i16;
param N: i16;

const broadcast_rx_color: color = @get_color(0);
const broadcast_tx_color: color = @get_color(1);

const reduce_A_color: color = @get_color(5);
const reduce_B_color: color = @get_color(6);
const reduce_C_color: color = @get_color(7);

const memcpy = @import_module("<memcpy/get_params>", .{
  .width = kernel_x_dim,
  .height = kernel_y_dim,
  .MEMCPYH2D_1 = MEMCPYH2D_DATA_1,
  .MEMCPYH2D_2 = MEMCPYH2D_DATA_2,
  .MEMCPYD2H_1 = MEMCPYD2H_DATA_1
});

layout {
  @set_rectangle(kernel_x_dim, kernel_y_dim);

  // --- Broadcast Routes ---
  const BCAST_RX_HEAD = .{ .routes = .{ .rx = .{SOUTH}, .tx = .{RAMP} } };
  const BCAST_TX_HEAD = .{ .routes = .{ .rx = .{RAMP}, .tx = .{SOUTH, RAMP} } };

  const BCAST_RX_MID  = .{ .routes = .{ .rx = .{RAMP, SOUTH}, .tx = .{NORTH} } };
  const BCAST_TX_MID  = .{ .routes = .{ .rx = .{NORTH}, .tx = .{SOUTH, RAMP} } };

  const BCAST_RX_TAIL = .{ .routes = .{ .rx = .{RAMP}, .tx = .{NORTH} } };
  const BCAST_TX_TAIL = .{ .routes = .{ .rx = .{NORTH}, .tx = .{RAMP} } };

  // --- Ring Reduction Routes ---
  const RED_TX_E = .{ .routes = .{ .rx = .{RAMP}, .tx = .{EAST} } };
  const RED_RX_W = .{ .routes = .{ .rx = .{WEST}, .tx = .{RAMP} } };
  const RED_TX_W = .{ .routes = .{ .rx = .{RAMP}, .tx = .{WEST} } };
  const RED_RX_E = .{ .routes = .{ .rx = .{EAST}, .tx = .{RAMP} } };
  const RED_PASS = .{ .routes = .{ .rx = .{EAST}, .tx = .{WEST} } };

  // --- Tile Config Parameters ---
  const common_params = .{
    .dM = M / kernel_y_dim,
    .dN = N / kernel_x_dim,
    .dN_y = N / kernel_y_dim,
    .dH = H / kernel_x_dim,
    .kernel_x_dim = kernel_x_dim,
    .kernel_y_dim = kernel_y_dim,
    .broadcast_tx_color = broadcast_tx_color,
    .broadcast_rx_color = broadcast_rx_color,
  };

  const params_0         = @concat_structs(common_params, .{ .reduce_tx_color = reduce_A_color, .reduce_rx_color = reduce_C_color });
  const params_odd       = @concat_structs(common_params, .{ .reduce_tx_color = reduce_B_color, .reduce_rx_color = reduce_A_color });
  const params_even      = @concat_structs(common_params, .{ .reduce_tx_color = reduce_A_color, .reduce_rx_color = reduce_B_color });
  const params_last_odd  = @concat_structs(common_params, .{ .reduce_tx_color = reduce_C_color, .reduce_rx_color = reduce_A_color });
  const params_last_even = @concat_structs(common_params, .{ .reduce_tx_color = reduce_C_color, .reduce_rx_color = reduce_B_color });

  for (@range(i16, kernel_x_dim)) |pe_x| {
    for (@range(i16, kernel_y_dim)) |pe_y| {

      // 1. Assign Pre-Computed Tile Codes
      if (pe_x == 0) {
          @set_tile_code(pe_x, pe_y, "pe.csl", @concat_structs(.{ .pe_x = pe_x, .pe_y = pe_y, .memcpy_params = memcpy.get_params(pe_x) }, params_0));
      } else if (pe_x == kernel_x_dim - 1) {
          if (pe_x % 2 == 1) {
              @set_tile_code(pe_x, pe_y, "pe.csl", @concat_structs(.{ .pe_x = pe_x, .pe_y = pe_y, .memcpy_params = memcpy.get_params(pe_x) }, params_last_odd));
          } else {
              @set_tile_code(pe_x, pe_y, "pe.csl", @concat_structs(.{ .pe_x = pe_x, .pe_y = pe_y, .memcpy_params = memcpy.get_params(pe_x) }, params_last_even));
          }
      } else {
          if (pe_x % 2 == 1) {
              @set_tile_code(pe_x, pe_y, "pe.csl", @concat_structs(.{ .pe_x = pe_x, .pe_y = pe_y, .memcpy_params = memcpy.get_params(pe_x) }, params_odd));
          } else {
              @set_tile_code(pe_x, pe_y, "pe.csl", @concat_structs(.{ .pe_x = pe_x, .pe_y = pe_y, .memcpy_params = memcpy.get_params(pe_x) }, params_even));
          }
      }

      // 2. Broadcast Colors
      if (pe_y == 0) {
          @set_color_config(pe_x, pe_y, broadcast_rx_color, BCAST_RX_HEAD);
          @set_color_config(pe_x, pe_y, broadcast_tx_color, BCAST_TX_HEAD);
      } else if (pe_y == kernel_y_dim - 1) {
          @set_color_config(pe_x, pe_y, broadcast_rx_color, BCAST_RX_TAIL);
          @set_color_config(pe_x, pe_y, broadcast_tx_color, BCAST_TX_TAIL);
      } else {
          @set_color_config(pe_x, pe_y, broadcast_rx_color, BCAST_RX_MID);
          @set_color_config(pe_x, pe_y, broadcast_tx_color, BCAST_TX_MID);
      }

      // 3. Ring Reduction Colors
      if (pe_x == 0) {
          @set_color_config(pe_x, pe_y, reduce_A_color, RED_TX_E);
          @set_color_config(pe_x, pe_y, reduce_C_color, RED_RX_E);
      } else if (pe_x == kernel_x_dim - 1) {
          if (pe_x % 2 == 1) {
              @set_color_config(pe_x, pe_y, reduce_A_color, RED_RX_W);
          } else {
              @set_color_config(pe_x, pe_y, reduce_B_color, RED_RX_W);
          }
          @set_color_config(pe_x, pe_y, reduce_C_color, RED_TX_W);
      } else {
          if (pe_x % 2 == 1) {
              @set_color_config(pe_x, pe_y, reduce_A_color, RED_RX_W);
              @set_color_config(pe_x, pe_y, reduce_B_color, RED_TX_E);
          } else {
              @set_color_config(pe_x, pe_y, reduce_B_color, RED_RX_W);
              @set_color_config(pe_x, pe_y, reduce_A_color, RED_TX_E);
          }
          @set_color_config(pe_x, pe_y, reduce_C_color, RED_PASS);
      }
    }
  }

  @export_name("A", [*]f32, true);
  @export_name("B", [*]f32, true);
  @export_name("C", [*]f32, true);
  @export_name("time_buf_u16", [*]u16, true);
  @export_name("broadcast_pe", fn () void);
}