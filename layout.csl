// Color map
//  ID var                   ID var               ID var               ID var
//   0 (unused)              9  bcast_color_1     18 reduce_1_flyover  27 reserved (memcpy)
//   1 (unused)              10 bcast_color_2     19                   28 reserved (memcpy)
//   2 MEMCPYH2D_1           11 bcast_color_3     20                   29 reserved
//   3 MEMCPYH2D_2           12 bcast_color_4     21 reserved (memcpy) 30 reserved (memcpy)
//   4 MEMCPYD2H_1           13 bcast_color_5     22 reserved (memcpy) 31 reserved
//   5 reduce_0_A_color      14 bcast_color_6     23 reserved (memcpy) 32
//   6 reduce_0_B_color      15 bcast_color_7     24                   33
//   7 reduce_0_flyover      16 reduce_1_A_color  25                   34
//   8 bcast_color_0         17 reduce_1_B_color  26                   35

// IDs for memcpy streaming colors
param MEMCPYH2D_DATA_1_ID: i16;
param MEMCPYH2D_DATA_2_ID: i16;
param MEMCPYD2H_DATA_1_ID: i16;

// Colors
const MEMCPYH2D_DATA_1: color = @get_color(MEMCPYH2D_DATA_1_ID);
const MEMCPYH2D_DATA_2: color = @get_color(MEMCPYH2D_DATA_2_ID);
const MEMCPYD2H_DATA_1: color = @get_color(MEMCPYD2H_DATA_1_ID);

// Kernel dimensions
param kernel_x_dim: i16;
param kernel_y_dim: i16;

// Total matrix dimensions
param M: i16;
param H: i16;
param N: i16;

const STREAM_WINDOW: i16 = 2;

// Reduction colors
const reduce_0_A_color: color = @get_color(5);
const reduce_0_B_color: color = @get_color(6);
const reduce_0_flyover_color: color = @get_color(7);

const bcast_color_0: color = @get_color(8);
const bcast_color_1: color = @get_color(9);
const bcast_color_2: color = @get_color(10);
const bcast_color_3: color = @get_color(11);
const bcast_color_4: color = @get_color(12);
const bcast_color_5: color = @get_color(13);
const bcast_color_6: color = @get_color(14);
const bcast_color_7: color = @get_color(15);

const reduce_1_A_color: color = @get_color(16);
const reduce_1_B_color: color = @get_color(17);
const reduce_1_flyover_color: color = @get_color(18);

// Memcpy infrastructure (provided)
const memcpy = @import_module("<memcpy/get_params>", .{
  .width = kernel_x_dim,
  .height = kernel_y_dim,
  .MEMCPYH2D_1 = MEMCPYH2D_DATA_1,
  .MEMCPYH2D_2 = MEMCPYH2D_DATA_2,
  .MEMCPYD2H_1 = MEMCPYD2H_DATA_1
});

layout {
  @set_rectangle(kernel_x_dim, kernel_y_dim);

  @comptime_assert(M % kernel_y_dim == 0);
  @comptime_assert(H % kernel_x_dim == 0);
  @comptime_assert(N % kernel_y_dim == 0);
  @comptime_assert(N % kernel_x_dim == 0);
  @comptime_assert(kernel_x_dim >= 2);
  @comptime_assert(kernel_y_dim >= 2);
  @comptime_assert(kernel_y_dim <= 8);
  @comptime_assert(STREAM_WINDOW == 2);

  const common_params = .{
    .dM = M / kernel_y_dim,
    .dN = N / kernel_x_dim,
    .dN_y = N / kernel_y_dim,
    .dH = H / kernel_x_dim,
    .kernel_x_dim = kernel_x_dim,
    .kernel_y_dim = kernel_y_dim,
    .bcast_color_0 = bcast_color_0,
    .bcast_color_1 = bcast_color_1,
    .bcast_color_2 = bcast_color_2,
    .bcast_color_3 = bcast_color_3,
    .bcast_color_4 = bcast_color_4,
    .bcast_color_5 = bcast_color_5,
    .bcast_color_6 = bcast_color_6,
    .bcast_color_7 = bcast_color_7,
  };

  for (@range(i16, kernel_x_dim)) |pe_x| {
    for (@range(i16, kernel_y_dim)) |pe_y| {
      const my_bcast_color = @get_color(8 + pe_y);

      if (pe_x % 2 == 0) {
        @set_tile_code(pe_x, pe_y, "pe.csl", @concat_structs(
          common_params,
          .{
            .memcpy_params = memcpy.get_params(pe_x),
            .my_bcast_color = my_bcast_color,
            .reduce_0_tx_color = reduce_0_A_color,
            .reduce_0_rx_color = reduce_0_B_color,
            .reduce_0_flyover_color = reduce_0_flyover_color,
            .reduce_1_tx_color = reduce_1_A_color,
            .reduce_1_rx_color = reduce_1_B_color,
            .reduce_1_flyover_color = reduce_1_flyover_color,
          },
        ));
      } else {
        @set_tile_code(pe_x, pe_y, "pe.csl", @concat_structs(
          common_params,
          .{
            .memcpy_params = memcpy.get_params(pe_x),
            .my_bcast_color = my_bcast_color,
            .reduce_0_tx_color = reduce_0_B_color,
            .reduce_0_rx_color = reduce_0_A_color,
            .reduce_0_flyover_color = reduce_0_flyover_color,
            .reduce_1_tx_color = reduce_1_B_color,
            .reduce_1_rx_color = reduce_1_A_color,
            .reduce_1_flyover_color = reduce_1_flyover_color,
          },
        ));
      }

      // Bidirectional column broadcast: every source row has its own color.
      for (@range(i16, kernel_y_dim)) |s| {
        const bc = @get_color(8 + s);

        if (pe_y == s) {
          if (s == 0) {
            @set_color_config(pe_x, pe_y, bc, .{
              .routes = .{ .rx = .{RAMP}, .tx = .{SOUTH, RAMP} },
            });
          } else if (s == kernel_y_dim - 1) {
            @set_color_config(pe_x, pe_y, bc, .{
              .routes = .{ .rx = .{RAMP}, .tx = .{NORTH, RAMP} },
            });
          } else {
            @set_color_config(pe_x, pe_y, bc, .{
              .routes = .{ .rx = .{RAMP}, .tx = .{NORTH, SOUTH, RAMP} },
            });
          }
        } else if (pe_y < s) {
          if (pe_y == 0) {
            @set_color_config(pe_x, pe_y, bc, .{
              .routes = .{ .rx = .{SOUTH}, .tx = .{RAMP} },
            });
          } else {
            @set_color_config(pe_x, pe_y, bc, .{
              .routes = .{ .rx = .{SOUTH}, .tx = .{NORTH, RAMP} },
            });
          }
        } else {
          if (pe_y == kernel_y_dim - 1) {
            @set_color_config(pe_x, pe_y, bc, .{
              .routes = .{ .rx = .{NORTH}, .tx = .{RAMP} },
            });
          } else {
            @set_color_config(pe_x, pe_y, bc, .{
              .routes = .{ .rx = .{NORTH}, .tx = .{SOUTH, RAMP} },
            });
          }
        }
      }

      // Lane 0 horizontal reduction ring.
      if (pe_x % 2 == 0) {
        @set_color_config(pe_x, pe_y, reduce_0_A_color, .{
          .routes = .{ .rx = .{RAMP}, .tx = .{EAST} },
        });
        @set_color_config(pe_x, pe_y, reduce_0_B_color, .{
          .routes = .{ .rx = .{WEST}, .tx = .{RAMP} },
        });
      } else {
        @set_color_config(pe_x, pe_y, reduce_0_B_color, .{
          .routes = .{ .rx = .{RAMP}, .tx = .{EAST} },
        });
        @set_color_config(pe_x, pe_y, reduce_0_A_color, .{
          .routes = .{ .rx = .{WEST}, .tx = .{RAMP} },
        });
      }

      if (pe_x == kernel_x_dim - 1) {
        @set_color_config(pe_x, pe_y, reduce_0_flyover_color, .{
          .routes = .{ .rx = .{RAMP}, .tx = .{WEST} },
        });
      } else if (pe_x == 0) {
        @set_color_config(pe_x, pe_y, reduce_0_flyover_color, .{
          .routes = .{ .rx = .{EAST}, .tx = .{RAMP} },
        });
      } else {
        @set_color_config(pe_x, pe_y, reduce_0_flyover_color, .{
          .routes = .{ .rx = .{EAST}, .tx = .{WEST} },
        });
      }

      // Lane 1 horizontal reduction ring.
      if (pe_x % 2 == 0) {
        @set_color_config(pe_x, pe_y, reduce_1_A_color, .{
          .routes = .{ .rx = .{RAMP}, .tx = .{EAST} },
        });
        @set_color_config(pe_x, pe_y, reduce_1_B_color, .{
          .routes = .{ .rx = .{WEST}, .tx = .{RAMP} },
        });
      } else {
        @set_color_config(pe_x, pe_y, reduce_1_B_color, .{
          .routes = .{ .rx = .{RAMP}, .tx = .{EAST} },
        });
        @set_color_config(pe_x, pe_y, reduce_1_A_color, .{
          .routes = .{ .rx = .{WEST}, .tx = .{RAMP} },
        });
      }

      if (pe_x == kernel_x_dim - 1) {
        @set_color_config(pe_x, pe_y, reduce_1_flyover_color, .{
          .routes = .{ .rx = .{RAMP}, .tx = .{WEST} },
        });
      } else if (pe_x == 0) {
        @set_color_config(pe_x, pe_y, reduce_1_flyover_color, .{
          .routes = .{ .rx = .{EAST}, .tx = .{RAMP} },
        });
      } else {
        @set_color_config(pe_x, pe_y, reduce_1_flyover_color, .{
          .routes = .{ .rx = .{EAST}, .tx = .{WEST} },
        });
      }
    }
  }

  @export_name("A", [*]f32, true);
  @export_name("B", [*]f32, true);
  @export_name("C", [*]f32, true);
  @export_name("time_buf_u16", [*]u16, true);
  @export_name("broadcast_pe", fn () void);
}
